---
import Docs from '../layouts/Docs.astro';
import {byCategory, components, demoByName, slug, astryxVersion} from '../lib/catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ported = components.filter((c) => demoByName.has(c.name)).length;
---
<Docs title="Overview">
  <h1>Astryx for Astro</h1>
  <p class="lede">
    An unofficial port of Meta's Astryx design system ({astryxVersion}) to server-rendered Astro components,
    with small light-DOM web components only where behaviour needs JavaScript. Themes are generated from Astryx's
    own theme sources, so every Astryx theme works unchanged.
  </p>
  <p class="progress">{ported} of {components.length} components ported</p>
  {byCategory().map(([category, items]) => (
    <section>
      <h2>{category}</h2>
      <ul class="grid">
        {items.map((c) => (
          <li>
            <a href={`${base}/components/${slug(c.name)}/`} data-ported={demoByName.has(c.name) ? '' : undefined}>
              <strong>{c.displayName}</strong>
              <span>{c.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Docs>

<style>
  .lede { max-width: 70ch; color: var(--color-text-secondary); }
  .progress { font-weight: var(--font-weight-semibold); }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--spacing-3); }
  .grid a { display: grid; gap: var(--spacing-1); height: 100%; box-sizing: border-box; padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-element); background: var(--color-background-surface); color: inherit; text-decoration: none; opacity: 0.55; }
  .grid a[data-ported] { opacity: 1; }
  .grid a:hover { border-color: var(--color-accent); }
  .grid span { font-size: var(--font-size-sm); color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
