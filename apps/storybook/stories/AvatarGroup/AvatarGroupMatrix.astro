---
/**
 * Story wrapper: an AvatarGroup at every size × shape, each with three Avatars and an
 * overflow chip. The group's size and shape win over its members', which only works when the
 * members render inside the group in one Astro render.
 */
import Avatar, {type AvatarShape, type AvatarSize} from 'astryx-astro/components/Avatar/Avatar.astro';
import AvatarGroup from 'astryx-astro/components/AvatarGroup/AvatarGroup.astro';
import AvatarGroupOverflow from 'astryx-astro/components/AvatarGroup/AvatarGroupOverflow.astro';

const photo =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d8cff"/><stop offset="1" stop-color="#b06dff"/></linearGradient></defs><rect width="96" height="96" fill="url(#g)"/><circle cx="48" cy="38" r="17" fill="#fff" fill-opacity=".85"/><path d="M14 96c4-22 18-32 34-32s30 10 34 32z" fill="#fff" fill-opacity=".85"/></svg>',
  );
const sizes: AvatarSize[] = ['xsm', 'sm', 'md', 'lg', 'xl'];
const shapes: AvatarShape[] = ['circle', 'rounded', 'square'];
const grid = `display:grid;grid-template-columns:repeat(${shapes.length + 1},max-content);align-items:center;gap:var(--spacing-4) var(--spacing-6)`;
const head = 'font-size:var(--font-size-sm);color:var(--color-text-secondary)';
---
<div style={grid}>
  <span></span>
  {shapes.map((shape) => <span style={head}>{shape}</span>)}
  {sizes.map((size) => (
    <>
      <span style={head}>{size}</span>
      {shapes.map((shape) => (
        <AvatarGroup size={size} shape={shape} aria-label={`Team (${size}, ${shape})`}>
          <Avatar name="Ada Lovelace" src={photo} />
          <Avatar name="Grace Hopper" />
          <Avatar name="Linus Torvalds" />
          <AvatarGroupOverflow count={12} />
        </AvatarGroup>
      ))}
    </>
  ))}
</div>
