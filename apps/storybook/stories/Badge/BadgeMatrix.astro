---
/**
 * Story wrapper: every Badge variant (the semantic ones, the colour ones and the neutral
 * theme's `gray`) as a plain label, with an icon and with a count, so one story shows a theme's
 * whole badge palette.
 */
import Badge, {type BadgeVariant} from 'astryx-astro/components/Badge/Badge.astro';

const variants: BadgeVariant[] = [
  'neutral', 'info', 'success', 'warning', 'error',
  'blue', 'cyan', 'green', 'orange', 'pink', 'purple', 'red', 'teal', 'yellow', 'gray',
];
const icons: Record<string, string> = {info: 'info', success: 'check', warning: 'warning', error: 'error'};
const grid = 'display:grid;grid-template-columns:repeat(4,max-content);align-items:center;gap:var(--spacing-2) var(--spacing-4)';
const head = 'font-size:var(--font-size-sm);color:var(--color-text-secondary)';
---
<div style={grid}>
  <span></span><span style={head}>label</span><span style={head}>icon</span><span style={head}>count</span>
  {variants.map((variant) => (
    <>
      <span style={head}>{variant}</span>
      <Badge variant={variant} label={variant[0].toUpperCase() + variant.slice(1)} />
      <Badge variant={variant} label="Synced" icon={icons[variant] ?? 'check'} />
      <Badge variant={variant} label={12} />
    </>
  ))}
</div>
