---
/**
 * Story wrapper: a ChatLayout in a short frame holding a long, deterministic conversation,
 * so it scrolls: the layout starts at the bottom and shows its scroll-to-bottom button when
 * the reader scrolls up. A template holds one more message for the play test to append.
 */
import ChatComposer from 'astryx-astro/components/Chat/ChatComposer.astro';
import ChatLayout from 'astryx-astro/components/Chat/ChatLayout.astro';
import ChatMessage from 'astryx-astro/components/Chat/ChatMessage.astro';
import ChatMessageBubble from 'astryx-astro/components/Chat/ChatMessageBubble.astro';
import ChatMessageList from 'astryx-astro/components/Chat/ChatMessageList.astro';

const turns = Array.from({length: 12}, (_, i) => ({
  question: `Question ${i + 1}: what changed in build ${100 + i}?`,
  answer: `Build ${100 + i} updated ${i + 2} packages and fixed ${(i % 3) + 1} flaky tests in the toolbar suite.`,
}));
const frame = 'display:flex;flex-direction:column;height:420px;max-width:640px;border:1px solid var(--color-border);border-radius:var(--radius-container);overflow:hidden;background:var(--color-background-surface)';
---
<div style={frame}>
  <ChatLayout>
    <ChatMessageList>
      {turns.map(({question, answer}) => (
        <>
          <ChatMessage sender="user"><ChatMessageBubble>{question}</ChatMessageBubble></ChatMessage>
          <ChatMessage sender="assistant" name="Navi"><ChatMessageBubble variant="ghost">{answer}</ChatMessageBubble></ChatMessage>
        </>
      ))}
    </ChatMessageList>
    <ChatComposer slot="composer" placeholder="Message Navi…" />
  </ChatLayout>
</div>
<template data-chat-new-message>
  <ChatMessage sender="assistant" name="Navi"><ChatMessageBubble variant="ghost">A message that arrived while you were reading.</ChatMessageBubble></ChatMessage>
</template>
