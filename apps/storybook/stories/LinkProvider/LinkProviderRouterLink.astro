---
/**
 * Story helper: a custom link component as an app would write one for LinkProvider (here it
 * marks the anchor as a router link and prefetches on hover). It receives `href`, `to`,
 * `class`, `style`, the other attributes and the link content as its default slot.
 */
interface Props {
  href?: string;
  to?: string;
  [attr: string]: unknown;
}
const {href, to, slot: _slot, ...rest} = Astro.props as Props & {slot?: string};
---
<a {...rest} href={to ?? href} data-router-link="" data-astro-prefetch="hover"><slot /></a>
