---
/**
 * Story wrapper: the trigger's looks side by side: each `size` (sm, md, lg) in the default
 * ghost and the secondary `variant`, a custom `icon`, and the disabled trigger. Each menu opens.
 */
import MoreMenu from 'astryx-astro/components/MoreMenu/MoreMenu.astro';
import type {DropdownMenuOption} from 'astryx-astro/components/DropdownMenu/menuShared';
import HStack from 'astryx-astro/components/Stack/HStack.astro';
import VStack from 'astryx-astro/components/Stack/VStack.astro';
import Text from 'astryx-astro/components/Text/Text.astro';
import type {ComponentSize} from 'astryx-astro/lib/types';

const items: DropdownMenuOption[] = [
  {label: 'Edit', icon: 'wrench', id: 'edit'},
  {label: 'Duplicate', icon: 'copy', id: 'duplicate'},
  {type: 'divider'},
  {type: 'section', title: 'Danger zone', items: [{label: 'Delete', variant: 'destructive', id: 'delete'}]},
];
const sizes: ComponentSize[] = ['sm', 'md', 'lg'];
const variants = ['ghost', 'secondary'] as const;
---
<VStack gap={4}>
  {variants.map((variant) => (
    <HStack gap={4} vAlign="center">
      <Text type="body" size="sm" color="secondary" style="width:84px">{variant}</Text>
      {sizes.map((size) => <MoreMenu items={items} variant={variant} size={size} label={`More options (${variant}, ${size})`} />)}
    </HStack>
  ))}
  <HStack gap={4} vAlign="center">
    <Text type="body" size="sm" color="secondary" style="width:84px">icon, disabled</Text>
    <MoreMenu items={items} icon="menu" label="Menu" />
    <MoreMenu items={items} isDisabled label="More options (disabled)" />
  </HStack>
</VStack>
