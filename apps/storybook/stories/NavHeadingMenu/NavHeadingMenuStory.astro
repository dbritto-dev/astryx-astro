---
/**
 * Story wrapper: a NavHeadingMenu with NavHeadingMenuItems, on a popover-like surface (alone it
 * is the content of a heading's popover), or as the `menu` of a TopNavHeading (`inHeading`).
 * The menu stamps its size onto the rows in the same render, hence a wrapper.
 */
import NavHeadingMenu, {type Props as NavHeadingMenuProps} from 'astryx-astro/components/NavMenu/NavHeadingMenu.astro';
import NavHeadingMenuItem from 'astryx-astro/components/NavMenu/NavHeadingMenuItem.astro';
import NavIcon from 'astryx-astro/components/NavIcon/NavIcon.astro';
import TopNavHeading from 'astryx-astro/components/TopNav/TopNavHeading.astro';
import {chartIcon, folderIcon, logoMark, usersIcon} from 'astryx-astro/components/NavItem/_demoIcons';

interface Props {
  /** Forwarded to NavHeadingMenu. */
  size?: NavHeadingMenuProps['size'];
  /** Forwarded to NavHeadingMenu. */
  minWidth?: NavHeadingMenuProps['minWidth'];
  /**
   * Story-only: the rows. `products` icons, descriptions, an action row and a disabled link;
   * `pages` three short rows with a disabled one; `workspace` two rows with a description.
   */
  rows?: 'products' | 'pages' | 'workspace';
  /** Story-only: render the menu as a TopNavHeading's `menu` (the whole heading opens it). */
  inHeading?: boolean;
}
const {size, minWidth, rows = 'products', inHeading = false} = Astro.props;
const box = 'display:inline-block;border:1px solid var(--color-border);border-radius:var(--radius-container);padding:var(--spacing-1);background:var(--color-background-popover)';
---
{inHeading ? (
  <TopNavHeading heading="Acme Cloud" superheading="Acme Suite">
    <NavIcon slot="logo" icon={logoMark} />
    <NavHeadingMenu slot="menu" size={size} minWidth={minWidth}>
      <NavHeadingMenuItem label="Acme Cloud" description="Current product" href="#cloud" />
      <NavHeadingMenuItem label="Acme Analytics" href="#analytics" />
      <NavHeadingMenuItem label="Acme Billing" href="#billing" />
    </NavHeadingMenu>
  </TopNavHeading>
) : (
  <div style={box}>
    {rows === 'products' && (
      <NavHeadingMenu size={size} minWidth={minWidth} aria-label="Products">
        <NavHeadingMenuItem label="Analytics" description="Dashboards and funnels" icon={chartIcon} href="#analytics" />
        <NavHeadingMenuItem label="Projects" description="Boards and roadmaps" icon={folderIcon} href="#projects" />
        <NavHeadingMenuItem label="People" description="Directory and teams" icon={usersIcon} />
        <NavHeadingMenuItem label="Billing" description="Plans and invoices" href="#billing" isDisabled />
      </NavHeadingMenu>
    )}
    {rows === 'pages' && (
      <NavHeadingMenu size={size} minWidth={minWidth} aria-label="Pages">
        <NavHeadingMenuItem label="Overview" href="#overview" />
        <NavHeadingMenuItem label="Reports" href="#reports" />
        <NavHeadingMenuItem label="Archive" isDisabled />
      </NavHeadingMenu>
    )}
    {rows === 'workspace' && (
      <NavHeadingMenu size={size} minWidth={minWidth} aria-label="Workspace">
        <NavHeadingMenuItem label="Switch workspace" description="Acme Inc. · 12 members" href="#workspaces" />
        <NavHeadingMenuItem label="Create workspace" href="#new-workspace" />
      </NavHeadingMenu>
    )}
  </div>
)}
