---
/**
 * Story wrapper: a range Slider with a `formatValue` function and marks. The formatter is a
 * server-side function (the values on the step grid are pre-formatted into the markup), so it
 * cannot travel in story args.
 */
import Slider from 'astryx-astro/components/Slider/Slider.astro';

interface Props {
  /** Forwarded to Slider. */
  label?: string;
  /** Forwarded to Slider. */
  valueDisplay?: 'tooltip' | 'text' | 'none';
}
const {label = 'Price range', valueDisplay = 'text'} = Astro.props;
const marks = [{value: 0}, {value: 250}, {value: 500}, {value: 750}, {value: 1000}];
---
<div style="max-width:360px;padding-block-end:var(--spacing-4)">
  <Slider label={label} value={[200, 800]} min={0} max={1000} step={10} marks={marks} formatValue={(v) => `$${v}`} valueDisplay={valueDisplay} />
</div>
