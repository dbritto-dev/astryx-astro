---
/**
 * Story wrapper: one fixed instant (12:00 UTC, 19 February 2026) in every format, every
 * text type and every color, side by side, plus a Timestamp inheriting a line of Text.
 * Clock-dependent formats (relative, relative_short, auto) pre-render the full UTC date and
 * time and switch to the distance from the viewer's clock in the browser.
 */
import Timestamp, {type TimestampFormat} from 'astryx-astro/components/Timestamp/Timestamp.astro';
import Text, {type TextColor, type TextType} from 'astryx-astro/components/Text/Text.astro';

const value = '2026-02-19T12:00:00Z';
const formats: TimestampFormat[] = [
  'relative', 'relative_short', 'auto', 'date', 'date_long', 'date_weekday', 'date_time', 'time',
  'system_date', 'system_date_time', 'system_time', 'unix_seconds',
];
const types: TextType[] = ['body', 'large', 'label', 'supporting', 'code', 'display-3'];
const colors: TextColor[] = ['primary', 'secondary', 'accent', 'disabled', 'placeholder'];
const row = 'display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--spacing-5)';
const cell = 'display:inline-flex;flex-direction:column;gap:var(--spacing-1);min-width:150px';
const caption = 'font-size:var(--font-size-xs);color:var(--color-text-secondary)';
---
<div style="display:grid;gap:var(--spacing-5);color:var(--color-text-primary)">
  <div style={row}>
    {formats.map((format) => <span style={cell} data-format-cell={format}><Timestamp value={value} format={format} /><span style={caption}>{format}</span></span>)}
  </div>
  <div style={row}>
    {types.map((type) => <span style={cell}><Timestamp value={value} format="date" type={type} /><span style={caption}>type {type}</span></span>)}
  </div>
  <div style={row}>
    {colors.map((color) => <span style={cell}><Timestamp value={value} format="date" color={color} /><span style={caption}>color {color}</span></span>)}
    <span style={cell}><Timestamp value={value} format="time" color="accent" size="lg" weight="semibold" /><span style={caption}>accent, lg, semibold</span></span>
    <span style={cell}><Text type="large">Due <Timestamp value={value} format="date" type="inherit" color="inherit" /></Text><span style={caption}>inherits the surrounding Text</span></span>
  </div>
</div>
