// ── Interaction tests (interactive components) ─────────────────────────────────────────────

/** What the user does and what happens (keyboard, pointer, focus, the event it reports). */
export const Default: Story = {
  play: async ({canvas, canvasElement, step}) => {
    // Wait until the component's element is defined (its script has run).
    const host = await upgraded(canvasElement, 'ax-<tag>');
    const changes = recordEvents<{value: string}>(canvasElement, 'astryx-change');
    const trigger = canvas.getByRole('button', {name: 'Save'});

    await step('Keyboard opens it', async () => {
      trigger.focus();
      await userEvent.keyboard('{Enter}');
      await waitFor(() => expect(isShowing(canvasElement.querySelector('[popover]'))).toBe(true));
    });

    await step('Escape closes it and returns focus', async () => {
      await userEvent.keyboard('{Escape}');
      await waitFor(() => expect(isShowing(canvasElement.querySelector('[popover]'))).toBe(false));
      await expect(trigger).toHaveFocus();
    });

    await expect(changes.map((event) => event.detail.value)).toEqual([]);
    await expect(host).toHaveAttribute('data-size', 'md');
  },
};

/** A story rendered open: docs show it in its own frame so the layer cannot cover the page. */
export const Open: Story = {
  args: {isOpen: true},
  parameters: {docs: {story: {inline: false, height: '360px'}}},
};
