{
  "name": "astryx-astro",
  "version": "0.1.0",
  "description": "Astryx design system re-implemented as Astro components with light-DOM web components. Unofficial port of Meta's Astryx.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "!src/**/*.demo.astro",
    "!src/**/demo-*",
    "!src/**/_demo*",
    "!src/**/demoData.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts",
    "./astryx.css": "./src/styles/astryx.css",
    "./themes/*.css": "./src/styles/themes/*.css",
    "./styles/*": "./src/styles/*",
    "./components/*.astro": "./src/components/*.astro",
    "./components/*.css": "./src/components/*.css",
    "./components/*": "./src/components/*.ts",
    "./elements/*": "./src/elements/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro",
    "astro-component",
    "web-components",
    "design-system",
    "astryx"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "index": "node scripts/build-index.mjs",
    "conformance": "node scripts/conformance.mjs",
    "generate": "node scripts/build-tokens.mjs && node scripts/build-syntax.mjs && node scripts/build-manifest.mjs && node scripts/build-index.mjs",
    "check:generated": "node scripts/build-tokens.mjs --check && node scripts/build-syntax.mjs --check && node scripts/build-manifest.mjs --check && node scripts/build-index.mjs --check",
    "check:baseline": "node scripts/baseline.mjs",
    "syntax": "node scripts/build-syntax.mjs"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.9",
    "@astryxdesign/core": "0.7.9",
    "@astryxdesign/theme-butter": "0.7.9",
    "@astryxdesign/theme-chocolate": "0.7.9",
    "@astryxdesign/theme-gothic": "0.7.9",
    "@astryxdesign/theme-matcha": "0.7.9",
    "@astryxdesign/theme-neutral": "0.7.9",
    "@astryxdesign/theme-stone": "0.7.9",
    "@astryxdesign/theme-y2k": "0.7.9",
    "astro": "^7.4.7",
    "web-features": "3.44.0"
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4",
    "lucide-static": "1.70.0",
    "ultrahtml": "^1.7.0"
  }
}
