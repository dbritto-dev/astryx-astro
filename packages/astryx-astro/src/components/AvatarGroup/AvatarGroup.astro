---
/**
 * AvatarGroup — a stacked, overlapping facepile of Avatars, optionally ending in an
 * AvatarGroupOverflow ("+N"). Port of @astryxdesign/core AvatarGroup/AvatarGroup.tsx and
 * AvatarGroup/AvatarGroupContext.ts.
 *
 * Compositional: pass the avatars you want visible (you slice), then the overflow. The
 * group's `size` and `shape` win over each member's own props, and every member overlaps
 * by a quarter of the size; Astryx's AvatarGroupContext becomes a stamp over the rendered
 * slot (cascade key `avatar-group`, see Avatar/avatarParts.ts), so members may be wrapped
 * in other markup.
 *
 * Accessibility: `role="group"` named by `aria-label` (default: translated "Avatars").
 * When a member is interactive (an Avatar with `href`/`isClickable`, or a clickable overflow,
 * all marked `data-avatar-item`), the group is one Tab stop with arrow-key roving focus
 * (Astryx useListFocus: `itemSelector: '[data-avatar-item]'`, horizontal, RTL-aware arrows,
 * Home/End, wrap, disabled members skipped, managed tabindex) through the shared runtime
 * (elements/runtime/roving.ts), and it is described by a keyboard hint.
 *
 * @example
 * <AvatarGroup size="lg">
 *   {users.slice(0, 3).map((u) => <Avatar src={u.src} name={u.name} />)}
 *   <AvatarGroupOverflow count={users.length - 3} />
 * </AvatarGroup>
 */
import type {HTMLAttributes} from 'astro/types';
import VisuallyHidden from '../VisuallyHidden/VisuallyHidden.astro';
import {cx, themeProps} from '../../lib/themeProps';
import {stamp} from '../../lib/cascade';
import {mergeStyles, type StyleValue} from '../../lib/style';
import {translator} from '../../lib/i18n';
import {groupOverlap, resolveSize, stampGroupPart, type AvatarShape, type AvatarSize} from '../Avatar/avatarParts';
import './AvatarGroup.css';

export interface Props extends HTMLAttributes<'div'> {
  /** Size applied to every member (wins over their own `size`). @default 'md' */
  size?: AvatarSize;
  /** Shape applied to every member and the overflow chip. @default 'circle' */
  shape?: AvatarShape;
  'data-testid'?: string;
  /** Screen-reader hint shown when members are interactive (port extension). @default translated */
  keyboardHintLabel?: string;
  /** Locale for the default label and hint. */
  locale?: string;
}

const {
  size = 'md',
  shape = 'circle',
  'data-testid': testId,
  'aria-label': ariaLabelProp,
  'aria-describedby': ariaDescribedByProp,
  keyboardHintLabel,
  locale,
  class: className,
  style,
  ...rest
} = Astro.props;

const t = translator(Astro, locale);
const ariaLabel = ariaLabelProp ?? t('@astryx.avatarGroup.label');
const numericSize = resolveSize(size);
const overlap = groupOverlap(numericSize);

const html = await stamp(await Astro.slots.render('default'), 'avatar-group', (attrs, tag) =>
  stampGroupPart(attrs, tag, {size, shape, numericSize, overlap}),
);
const hasInteractiveItems = /\sdata-avatar-item(=|\s|>)/.test(html);
const hintId = hasInteractiveItems ? `ax-avatar-group-hint-${Math.random().toString(36).slice(2, 10)}` : undefined;
const describedBy = [ariaDescribedByProp, hintId].filter(Boolean).join(' ') || undefined;

const {themeClass, attrs} = themeProps('avatar-group', {size, shape});
---
<div
  {...rest}
  role="group"
  aria-label={ariaLabel}
  aria-describedby={describedBy}
  data-testid={testId}
  data-astryx-roving={hasInteractiveItems ? 'horizontal' : undefined}
  data-astryx-roving-items={hasInteractiveItems ? '[data-avatar-item]' : undefined}
  {...attrs}
  class={cx(themeClass, className)}
  style={mergeStyles({'--_avatar-group-overlap': `${-overlap}px`}, style as StyleValue)}
><Fragment set:html={html} />{hasInteractiveItems && <VisuallyHidden id={hintId}>{keyboardHintLabel ?? t('@astryx.avatarGroup.keyboardHint')}</VisuallyHidden>}</div>
{hasInteractiveItems && <script>import '../../elements/runtime/roving';</script>}
