---
/**
 * AvatarGroupOverflow — the "+N" indicator at the end of an AvatarGroup. Port of
 * @astryxdesign/core AvatarGroup/AvatarGroupOverflow.tsx.
 *
 * Takes the group's size, shape and overlap (stamped by AvatarGroup, cascade key
 * `avatar-group`); standalone it is md / circle with no overlap. A negative count is
 * clamped to 0. Accessible name: the translated "{count} more" (`label` overrides it).
 * Static it is `role="img"`; with `onClick` it is a <button type="button"> carrying
 * `data-avatar-item`, so the group becomes keyboard-navigable.
 *
 * `onClick` (port note): an inline handler string (native `onclick`) or `true` to render
 * the button and attach a listener yourself.
 *
 * @example
 * <AvatarGroupOverflow count={users.length - 3} />
 * <AvatarGroupOverflow count={12} onClick="openAllMembers()" />
 */
import type {HTMLAttributes} from 'astro/types';
import {cx, themeProps} from '../../lib/themeProps';
import {inherits} from '../../lib/cascade';
import {mergeStyles, type StyleValue} from '../../lib/style';
import {translator} from '../../lib/i18n';
import {resolveSize} from '../Avatar/avatarParts';
import './AvatarGroup.css';

export interface Props extends Omit<HTMLAttributes<'span'>, 'onclick'> {
  /** The overflow count; "+N" by default. */
  count: number;
  /** Renders a <button type="button">: an inline handler string, or `true` to wire it yourself. */
  onClick?: string | true;
  /** Accessible name (port extension). @default translated "{count} more" */
  label?: string;
  /** Locale for the default accessible name. */
  locale?: string;
}

const {count, onClick, label: labelProp, locale, class: className, style, ...rest} = Astro.props;
const t = translator(Astro, locale);
const safeCount = Math.max(0, Number.isFinite(count) ? count : 0);
const label = labelProp ?? t('@astryx.avatarGroup.overflow', {count: safeCount});
const hasContent = Astro.slots.has('default');
// Group context default (no group): md, circle, no overlap.
const size = 'md';
const shape = 'circle';
const {themeClass, attrs} = themeProps('avatar-group-overflow', {size, shape});
const isButton = onClick != null && (onClick as unknown) !== false;
const shared = {
  ...attrs,
  'aria-label': label,
  'data-ax-avatar-part': 'overflow',
  'data-ax-inherit': inherits({'avatar-group': true}),
  style: mergeStyles({'--_ax-avatar-size': `${resolveSize(size)}px`, '--_avatar-group-overlap': '0px'}, style as StyleValue),
};
---
{isButton ? (
  <button type="button" onclick={typeof onClick === 'string' ? onClick : undefined} {...rest} {...shared} data-avatar-item="" class={cx(themeClass, 'ax-focus-visible', 'ax-overlay-image-neutral', className as string | undefined)}>{hasContent ? <slot /> : `+${safeCount}`}</button>
) : (
  <span role="img" {...rest} {...shared} class={cx(themeClass, className as string | undefined)}>{hasContent ? <slot /> : `+${safeCount}`}</span>
)}
