---
/**
 * Breadcrumbs — the trail from the root to the current page (WAI-ARIA APG breadcrumb): a
 * labelled `<nav>` landmark around an ordered list of BreadcrumbItem children.
 * Port of @astryxdesign/core Breadcrumbs/Breadcrumbs.tsx (+ BreadcrumbContext).
 * Theme targets: `.astryx-breadcrumbs[data-variant]` and the items' targets.
 *
 * `variant` (default | supporting) and `separator` reach every item through the subtree locals
 * key `astryxBreadcrumbs` (BreadcrumbContext). Each item renders its own leading separator,
 * hidden on the first item; it is decorative (`aria-hidden`). The built-in slash mirrors in
 * RTL; a custom separator is markup in the `separator` slot (or a `separator` string): mirror
 * arrows / Icons with `class="ax-mirror-rtl"`, leave bidi-mirrored glyphs such as › alone.
 *
 * Current page: an item with `isCurrent` gets `aria-current="page"`; when none is explicit the
 * last item is current (on its content element, link or not), unless it says `isCurrent={false}`.
 * Resolved on the server over the rendered trail.
 *
 * @example
 * <Breadcrumbs>
 *   <BreadcrumbItem href="/">Home</BreadcrumbItem>
 *   <BreadcrumbItem href="/projects">Projects</BreadcrumbItem>
 *   <BreadcrumbItem>My Project</BreadcrumbItem>
 * </Breadcrumbs>
 */
import type {HTMLAttributes} from 'astro/types';
import {cx, themeProps} from '../../lib/themeProps';
import {translator} from '../../lib/i18n';
import {renderWithLocals} from '../../lib/subtreeLocals';
import {BREADCRUMBS_LOCAL, DEFAULT_SEPARATOR_HTML, markAutoCurrent, type BreadcrumbsContextValue, type BreadcrumbsVariant} from './breadcrumbsShared';
import './Breadcrumbs.css';

export type {BreadcrumbsVariant};

export interface Props extends HTMLAttributes<'nav'> {
  /** Separator text between items (or markup in the `separator` slot); the slash mirrors in RTL. @default '/' */
  separator?: string;
  /** 'supporting': smaller, secondary text. @default 'default' */
  variant?: BreadcrumbsVariant;
  /** Accessible label of the nav landmark. @default translated 'Breadcrumb' */
  label?: string;
  locale?: string;
  'data-testid'?: string;
}

const {separator = '/', variant = 'default', label: labelProp, locale, class: className, slot: _slot, ...rest} = Astro.props as Props & {slot?: unknown};
const t = translator(Astro, locale);
const label = labelProp ?? t('@astryx.breadcrumbs.label');
const slotSeparator = Astro.slots.has('separator') ? (await Astro.slots.render('separator')).trim() : '';
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const separatorHtml = slotSeparator !== '' ? slotSeparator : separator === '/' ? DEFAULT_SEPARATOR_HTML : escape(separator);
const context: BreadcrumbsContextValue = {variant, separatorHtml};
const items = Astro.slots.has('default')
  ? await renderWithLocals(Astro, {[BREADCRUMBS_LOCAL]: context}, () => Astro.slots.render('default'))
  : '';
const html = await markAutoCurrent(items.trim());
const {themeClass, attrs} = themeProps('breadcrumbs', {variant});
---
<nav {...rest} aria-label={label} class={cx(themeClass, className)} {...attrs}><ol class="ax-breadcrumbs-list"><Fragment set:html={html} /></ol></nav>
