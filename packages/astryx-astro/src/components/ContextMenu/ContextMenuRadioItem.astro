---
/**
 * ContextMenuRadioItem — DropdownMenuRadioItem under its ContextMenu name (Astryx
 * ContextMenu/index.ts re-export): one option of a ContextMenuRadioGroup.
 */
import DropdownMenuRadioItem, {type Props as DropdownMenuRadioItemProps} from '../DropdownMenu/DropdownMenuRadioItem.astro';

export type Props = DropdownMenuRadioItemProps;
---
<DropdownMenuRadioItem {...Astro.props}>
  {Astro.slots.has('icon') && <slot name="icon" slot="icon" />}
  {Astro.slots.has('label') && <slot name="label" slot="label" />}
  {Astro.slots.has('description') && <slot name="description" slot="description" />}
  {Astro.slots.has('endContent') && <slot name="endContent" slot="endContent" />}
</DropdownMenuRadioItem>
