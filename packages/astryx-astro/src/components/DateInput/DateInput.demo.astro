---
import DateInput, {type DateInputSize} from './DateInput.astro';
import InputGroup from '../InputGroup/InputGroup.astro';
import InputGroupText from '../InputGroup/InputGroupText.astro';
import FormLayout from '../FormLayout/FormLayout.astro';
import Button from '../Button/Button.astro';
import type {InputStatusType} from '../Field/fieldProps';

const sizes: DateInputSize[] = ['sm', 'md', 'lg'];
const statuses: InputStatusType[] = ['error', 'warning', 'success'];
const messages: Record<InputStatusType, string> = {error: 'Pick a date in March', warning: 'This is a holiday', success: 'Available'};
const grid = 'display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:var(--spacing-5);align-items:start';
const cap = 'margin:0 0 var(--spacing-2);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);color:var(--color-text-secondary)';
const noWeekends = (date: Date) => date.getDay() !== 0 && date.getDay() !== 6;
---
<div style="display:grid;gap:var(--spacing-6);color:var(--color-text-primary)">
  <section>
    <h3 style={cap}>Typed entry and calendar</h3>
    <div style={grid}>
      <DateInput label="Event date" value="2026-03-21" description="Type a date or pick one" data-test="basic" />
      <DateInput label="Empty" data-test="empty" />
      <DateInput label="Short format" value="2026-03-21" format="date" hasClear data-test="clearable" />
      <DateInput label="ISO format" value="2026-03-21" format="system_date" />
      <DateInput label="With weekday, two months" value="2026-03-21" format="date_weekday" numberOfMonths={2} weekStartsOn="mon" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Presentation: "bottom-sheet" always, "adaptive-bottom-sheet" under a coarse pointer</h3>
    <div style={grid}>
      <DateInput label="Check-in (bottom sheet)" value="2026-03-21" presentation="bottom-sheet" data-test="sheet" />
      <DateInput label="Check-out (adaptive)" presentation="adaptive-bottom-sheet" data-test="adaptive-sheet" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Locales</h3>
    <div style={grid}>
      <DateInput label="Datum (de-DE)" locale="de-DE" value="2026-03-21" format="date" data-test="de" />
      <DateInput label="日付 (ja-JP)" locale="ja-JP" value="2026-03-21" format="date" data-test="ja" />
      <div dir="rtl" lang="ar-SA"><DateInput label="التاريخ (ar-SA)" locale="ar-SA" value="2026-03-21" format="date" data-test="ar" /></div>
      <DateInput label="Buddhist calendar (th-TH)" locale="th-TH" calendar="buddhist" value="2026-03-21" min="2020-01-01" max="2030-12-31" data-test="buddhist" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Bounds and constraints</h3>
    <div style={grid}>
      <DateInput label="March only" value="2026-03-10" min="2026-03-01" max="2026-03-31" description="Dates outside March are rejected" data-test="bounds" />
      <DateInput label="Weekdays" value="2026-03-10" dateConstraints={[noWeekends]} description="Weekends are unavailable" data-test="weekdays" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Status × size</h3>
    <div style={grid}>
      {statuses.map((type) => sizes.map((size) => (
        <DateInput label={`${type} ${size}`} size={size} value="2026-03-21" status={{type, message: messages[type]}} />
      )))}
      <DateInput label="Tooltip status" value="2026-03-21" status={{type: 'error', message: messages.error}} statusVariant="tooltip" data-test="tooltip-status" />
      <DateInput label="Detached status" value="2026-03-21" status={{type: 'warning', message: messages.warning}} statusVariant="detached" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Disabled, loading</h3>
    <div style={grid}>
      <DateInput label="Disabled" value="2026-03-21" isDisabled htmlName="disabled-date" data-test="disabled" />
      <DateInput label="Disabled with reason" value="2026-03-21" isDisabled disabledMessage="Locked after check-in" />
      <DateInput label="Loading" value="2026-03-21" isLoading data-test="loading" />
    </div>
  </section>

  <section>
    <h3 style={cap}>In a form, a FormLayout and an InputGroup</h3>
    <form data-test="form" style="max-width:560px;display:grid;gap:var(--spacing-3)">
      <FormLayout direction="horizontal-labels">
        <DateInput label="Check-in" htmlName="checkin" value="2026-03-21" isRequired />
        <DateInput label="Check-out" htmlName="checkout" isOptional hasClear />
      </FormLayout>
      <InputGroup label="Due date">
        <InputGroupText>Due</InputGroupText>
        <DateInput label="Due" htmlName="due" value="2026-04-01" />
      </InputGroup>
      <div style="display:flex;gap:var(--spacing-2)">
        <Button type="submit" label="Submit" variant="primary" />
        <Button type="reset" label="Reset" variant="secondary" />
      </div>
      <output data-test="form-output" style="font-family:var(--font-family-code);font-size:var(--font-size-sm)"></output>
    </form>
  </section>
</div>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-test="form"]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const out = form.querySelector('output');
    if (out) out.textContent = JSON.stringify(Object.fromEntries(new FormData(form)));
  });
</script>
