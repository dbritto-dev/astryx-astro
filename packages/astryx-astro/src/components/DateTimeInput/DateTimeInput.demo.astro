---
import DateTimeInput, {type DateTimeInputSize} from './DateTimeInput.astro';
import FormLayout from '../FormLayout/FormLayout.astro';
import Button from '../Button/Button.astro';
import type {InputStatusType} from '../Field/fieldProps';

const sizes: DateTimeInputSize[] = ['sm', 'md', 'lg'];
const statuses: InputStatusType[] = ['error', 'warning', 'success'];
const messages: Record<InputStatusType, string> = {error: 'The room is booked then', warning: 'Outside office hours', success: 'Everyone is free'};
const grid = 'display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:var(--spacing-5);align-items:start';
const cap = 'margin:0 0 var(--spacing-2);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);color:var(--color-text-secondary)';
---
<div style="display:grid;gap:var(--spacing-6);color:var(--color-text-primary)">
  <section>
    <h3 style={cap}>Date, time and preset times</h3>
    <div style={grid}>
      <DateTimeInput label="Meeting time" value="2026-03-21T14:30" description="Type or pick a date; type a time or use ↑/↓" data-test="basic" />
      <DateTimeInput label="Departure" timeOptionInterval={30} hasClear data-test="empty" />
      <DateTimeInput label="Reminder" value="2026-03-21T09:00" timeOptionInterval={15} timeIncrement={15} hasClear data-test="options" />
      <DateTimeInput label="Precise" value="2026-03-21T14:30:15" hasSeconds numberOfMonths={2} />
      <DateTimeInput label="Booking window" value="2026-03-10T09:00" min="2026-03-10T09:00" max="2026-03-20T17:30" timeOptionInterval={60} description="Mar 10, 9 AM – Mar 20, 5:30 PM" data-test="bounds" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Locales</h3>
    <div style={grid}>
      <DateTimeInput label="Termin (de-DE)" locale="de-DE" value="2026-03-21T14:30" timeOptionInterval={30} data-test="de" />
      <DateTimeInput label="日時 (ja-JP)" locale="ja-JP" value="2026-03-21T14:30" data-test="ja" />
      <div dir="rtl" lang="ar-SA"><DateTimeInput label="الموعد (ar-SA)" locale="ar-SA" value="2026-03-21T14:30" data-test="ar" /></div>
      <DateTimeInput label="12-hour override" locale="en-GB" hourFormat="12h" value="2026-03-21T14:30" />
    </div>
  </section>

  <section>
    <h3 style={cap}>Status × size</h3>
    <div style={grid}>
      {statuses.map((type) => sizes.map((size) => (
        <DateTimeInput label={`${type} ${size}`} size={size} value="2026-03-21T14:30" status={{type, message: messages[type]}} />
      )))}
    </div>
  </section>

  <section>
    <h3 style={cap}>Disabled, loading</h3>
    <div style={grid}>
      <DateTimeInput label="Disabled" value="2026-03-21T14:30" isDisabled htmlName="disabled-dt" data-test="disabled" />
      <DateTimeInput label="Disabled with reason" value="2026-03-21T14:30" isDisabled disabledMessage="The event has started" />
      <DateTimeInput label="Loading" value="2026-03-21T14:30" isLoading />
    </div>
  </section>

  <section>
    <h3 style={cap}>In a form</h3>
    <form data-test="form" style="max-width:640px;display:grid;gap:var(--spacing-3)">
      <FormLayout direction="horizontal-labels">
        <DateTimeInput label="Starts" htmlName="starts" value="2026-03-21T09:00" isRequired />
        <DateTimeInput label="Ends" htmlName="ends" isOptional hasClear />
      </FormLayout>
      <div style="display:flex;gap:var(--spacing-2)">
        <Button type="submit" label="Submit" variant="primary" />
        <Button type="reset" label="Reset" variant="secondary" />
      </div>
      <output data-test="form-output" style="font-family:var(--font-family-code);font-size:var(--font-size-sm)"></output>
    </form>
  </section>
</div>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-test="form"]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const out = form.querySelector('output');
    if (out) out.textContent = JSON.stringify(Object.fromEntries(new FormData(form)));
  });
</script>
