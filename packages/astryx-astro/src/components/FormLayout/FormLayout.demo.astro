---
import FormLayout from './FormLayout.astro';
import TextInput from '../TextInput/TextInput.astro';
import TextArea from '../TextArea/TextArea.astro';
const cap = 'margin:0 0 var(--spacing-2);font-size:var(--font-size-sm);color:var(--color-text-secondary)';
---
<div>
  <p style={cap}>direction="vertical" (default)</p>
  <FormLayout style="max-width:360px">
    <TextInput label="Name" value="Ada Lovelace" />
    <TextInput label="Email" type="email" value="ada@example.com" />
  </FormLayout>
</div>
<div>
  <p style={cap}>direction="horizontal" — one 1fr track per child</p>
  <FormLayout direction="horizontal">
    <TextInput label="First name" />
    <TextInput label="Last name" />
    <TextInput label="Postal code" />
  </FormLayout>
</div>
<div>
  <p style={cap}>direction="horizontal-labels" defaultOptionality="required" (collapses to vertical at ≤480px)</p>
  <FormLayout direction="horizontal-labels" defaultOptionality="required" style="max-width:480px">
    <TextInput label="Organization" />
    <TextInput label="Website" type="url" description="Include https://" />
    <TextArea label="Notes" rows={3} />
  </FormLayout>
</div>
<div>
  <p style={cap}>Nested: horizontal inside vertical, defaultOptionality="optional"</p>
  <FormLayout defaultOptionality="optional" style="max-width:480px">
    <TextInput label="Street" />
    <FormLayout direction="horizontal">
      <TextInput label="City" />
      <TextInput label="Country" />
    </FormLayout>
  </FormLayout>
</div>
