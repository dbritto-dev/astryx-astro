---
/**
 * Item — the row primitive: marker + start content + label/description + end content.
 * Port of @astryxdesign/core Item/Item.tsx (styles, densityStyles, dynamicStyles),
 * Item/ItemSwipeLayer.tsx (panel markup and styles only), Item/ItemDescriptionContext.tsx,
 * Item/ItemListRowContext.tsx, Item/ItemMarkerColumnsContext.tsx, with
 * hooks/useClickableContainer.ts (behaviors/clickable.ts), Link/computeTargetAndRel.ts,
 * Link/useLinkComponent.ts, utils/safeUrl.ts, utils/focusOutline.stylex.ts and
 * utils/interactionOverlay.stylex.ts.
 *
 * Theme hooks: `.astryx-item[data-density][data-align]` with states `data-highlighted`,
 * `data-selected="selected"`, `data-disabled`; `.astryx-item-swipe-panel[data-side]`,
 * `.astryx-item-swipe-action[data-variant]`; private vars `--_item-inset-inline` (padding-inline
 * derives from it; themes that set `paddingInline` on `item` feed it), `--_item-label-color`,
 * `--_item-description-color`.
 *
 * What the root is (Astryx rules):
 *  - `interactiveRole="button"` (Astryx `onClick`): the label column is an invisible
 *    `<button type="button">` (the row's tab stop; native `disabled` when disabled). A click
 *    anywhere else on the row that is not inside a nested control is retargeted to that
 *    button, so `click` fires exactly once, on the button, and bubbles to the row.
 *  - `href` (safeHref-checked): the label column is an invisible link through the link
 *    component (`Astro.locals.astryxLinkComponent`); a surface click is re-dispatched on it
 *    with its modifier keys and a middle click opens a new tab (useClickableContainerProxy).
 *    Disabled: `<a role="link" aria-disabled="true" tabindex="-1">` with no destination.
 *    A blocked destination renders an `<a>` without href (inert, not disabled).
 *  - `interactiveRef="<selector>"` (delegation, Astryx `interactiveRef`): the row is an enlarged
 *    target for a nested control in a slot (a checkbox): surface clicks are dispatched on it,
 *    no invisible button/link is rendered (one tab stop), the row is marked
 *    `data-pressable-container`. `href`/`interactiveRole` are ignored.
 *  - `role` (menuitem, option …): the parent owns keyboard and activation; the label column
 *    is a plain span and no invisible control is rendered. `as` a link component + `href`
 *    makes the root itself the anchor (menus that navigate).
 * `isSelected` → `aria-selected` on roles that allow it (option, tab, row, gridcell,
 * columnheader, rowheader, treeitem), else `aria-current="true"` (a caller's aria-current wins).
 *
 * Cascade key (lib/cascade.ts): `item-description` — a control in a slot that opts in with
 * `data-ax-inherit="item-description"` gets the description's id merged into its
 * `aria-describedby` (Astryx ItemDescriptionContext; CheckboxListItem reads it).
 *
 * Internal props for List (ItemListRowContext / ItemMarkerColumnsContext): `__listRow`,
 * `__markerColumns` (wrap start/label/end in one flex cell beside the marker).
 *
 * Deferred touch extras (AGENTS.md scope): the swipe gesture (`swipeActions` renders the
 * themed panels, inert and zero-width at rest, but nothing drags them open yet — every swipe
 * verb must also be reachable from the row's own content, as Astryx requires), the coarse
 * pointer press controller and the row press layer (rowPressLayerStyles).
 * Deviation: Astryx forwards a link row's surface clicks only for List rows under a coarse
 * pointer; here every link row forwards them (desktop parity with TreeList link rows).
 *
 * @example
 * <Item label="Ada Lovelace" description="Engineer"><Avatar slot="startContent" name="Ada Lovelace" size="sm" /></Item>
 * <Item label="Settings" href="/settings" />
 * <Item label="Archive" interactiveRole="button" density="compact" />
 */
import type {HTMLAttributes} from 'astro/types';
import Icon from '../Icon/Icon.astro';
import type {AstroIconComponent, ExtendedIconName} from '../Icon/iconRegistry';
import {cx, themeProps} from '../../lib/themeProps';
import {stamp} from '../../lib/cascade';
import {mergeStyles, type StyleValue} from '../../lib/style';
import {safeHref} from '../../lib/safeUrl';
import {uid} from '../../lib/uid';
import {computeTargetAndRel, resolveLinkComponent, type LinkComponentType} from '../Link/linkComponent';
import {cleanSlotHtml} from '../Button/buttonCascade';
import './Item.css';

export type ItemAlign = 'center' | 'start' | 'first-line';
export type ItemDensity = 'compact' | 'balanced' | 'spacious';
export type ItemSwipeActionVariant = 'neutral' | 'accent' | 'destructive';
export type ItemSwipeBehavior = 'reveal' | 'commit';

/** One verb a sideways drag uncovers (Astryx ItemSwipeAction, minus `onActivate`). */
export interface ItemSwipeAction {
  id?: string;
  /** The verb's name, and the button's accessible name while the row rests open. */
  label: string;
  /** Drawn above the label: an icon name / SVG string / Astro component. */
  icon?: ExtendedIconName | AstroIconComponent;
  isDisabled?: boolean;
  /** @default 'accent' */
  variant?: ItemSwipeActionVariant;
  /** The row holds out at the edge after this action fires. @default false */
  hasRemoval?: boolean;
}

export interface ItemSwipeActions {
  /** Uncovered by a drag toward the inline end; outermost last. */
  leading?: ItemSwipeAction[];
  /** Uncovered by a drag toward the inline start; outermost last. */
  trailing?: ItemSwipeAction[];
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'role'> {
  /**
   * The root element: a tag (`div`, `li`, `span` …) or a component. A link component with
   * `href` makes the root itself the anchor — only with a `role` and no controls in the slots.
   * @default 'div'
   */
  as?: LinkComponentType;
  /** Primary text (string, truncated to one line), or markup in the `label` slot. */
  label?: string;
  /** Secondary text, or markup in the `description` slot. */
  description?: string;
  /**
   * Vertical alignment of the start/end slots: centered on the text block, top-aligned, or
   * centered on the label's first line. @default 'center'
   */
  align?: ItemAlign;
  /** Block padding 4/8/12px; spacious also widens the inline inset to 12px. @default 'balanced' */
  density?: ItemDensity;
  /** Max label lines before an ellipsis. */
  labelLines?: number;
  /** Max description lines before an ellipsis. */
  descriptionLines?: number;
  /** `inline` keeps label and description on one line (description ellipsizes first). @default 'stacked' */
  layout?: 'stacked' | 'inline';
  /** Astro stand-in for Astryx `onClick`: a button row (listen for `click`). */
  interactiveRole?: 'button';
  /**
   * Astro stand-in for Astryx `interactiveRef`: a CSS selector (inside the row) for the nested
   * control that owns the row's keyboard access and action.
   */
  interactiveRef?: string;
  /** Link destination (safeHref-checked). */
  href?: string | URL;
  /** Link target; `_blank` merges `noopener noreferrer` into rel. */
  target?: '_blank' | '_self' | (string & {});
  rel?: string;
  /** Hover/keyboard-highlight fill. @default false */
  isHighlighted?: boolean;
  /** Selected fill + aria-selected / aria-current. @default false */
  isSelected?: boolean;
  /** @default false */
  isDisabled?: boolean;
  /** A semantic role (menuitem, option …): the parent owns keyboard access. */
  role?: string;
  /** Touch swipe verbs (panels rendered; the gesture is deferred — see header). */
  swipeActions?: ItemSwipeActions;
  /** @default 'reveal' */
  swipeBehavior?: ItemSwipeBehavior;
  'data-testid'?: string;
}

/** @internal List plumbing (ItemListRowContext / ItemMarkerColumnsContext). */
interface InternalProps {
  __listRow?: boolean;
  __markerColumns?: boolean;
}

const ARIA_SELECTED_ROLES = new Set(['option', 'tab', 'row', 'gridcell', 'columnheader', 'rowheader', 'treeitem']);
const SWIPE_ROLES = new Set(['listitem']);

const {
  as: asProp,
  label,
  description,
  align = 'center',
  density = 'balanced',
  labelLines,
  descriptionLines,
  layout = 'stacked',
  interactiveRole,
  interactiveRef,
  href: hrefProp,
  target: targetProp,
  rel: relProp,
  isHighlighted = false,
  isSelected = false,
  isDisabled = false,
  role,
  swipeActions,
  swipeBehavior = 'reveal',
  __listRow: isListRow = false,
  __markerColumns: hasMarkerColumns = false,
  class: className,
  style,
  ...rest
} = Astro.props as Props & InternalProps;

const Root = asProp ?? 'div';
const isDelegate = interactiveRef != null && interactiveRef !== '';
const href = isDelegate ? undefined : hrefProp;
const hasOnClick = !isDelegate && interactiveRole === 'button';
const isInteractive = hasOnClick || href != null || isDelegate;
const hasStateFill = isHighlighted || isSelected;
const {target, rel} = computeTargetAndRel(targetProp, relProp);
const hasParentRole = role != null;
const isLinkRoot = typeof Root !== 'string' && href != null;
const safe = href != null && !isDisabled ? safeHref(href) : undefined;
const allowsAriaSelected = role != null && ARIA_SELECTED_ROLES.has(role);

// Slots → HTML (isRenderable: empty output renders nothing).
const slotHtml = async (name: string) => (Astro.slots.has(name) ? (await cleanSlotHtml(await Astro.slots.render(name), name)).trim() : '');
const markerHtml = await slotHtml('marker');
const labelSlot = await slotHtml('label');
const descriptionSlot = await slotHtml('description');
let startHtml = await slotHtml('startContent');
let endHtml = await slotHtml('endContent');
const hasDescription = descriptionSlot !== '' || (description != null && description !== '');
const descriptionId = hasDescription ? uid(Astro, 'ax-item-desc') : undefined;

// ItemDescriptionContext → cascade key `item-description` (null provider without a description).
const mergeIds = (a: string | undefined, b: string) => [...new Set([...(a ?? '').split(/\s+/).filter(Boolean), b])].join(' ');
const describe = descriptionId ? (a: Record<string, string>) => { a['aria-describedby'] = mergeIds(a['aria-describedby'], descriptionId); } : null;
startHtml = await stamp(startHtml, 'item-description', describe);
endHtml = await stamp(endHtml, 'item-description', describe);

const isStringLabel = labelSlot === '';
const isStringDescription = descriptionSlot === '';
const isInline = layout === 'inline' && hasDescription;
const truncate = (lines: number | undefined, auto: boolean) =>
  lines != null ? (lines === 1 ? 'single' : 'multi') : auto ? 'single' : undefined;
const labelTruncate = truncate(labelLines, isStringLabel);
const descriptionTruncate = truncate(descriptionLines, isStringDescription || isInline);

// Swipe actions (served only where Astryx serves them).
const leading = swipeActions?.leading ?? [];
const trailing = swipeActions?.trailing ?? [];
const hasSwipe = (leading.length > 0 || trailing.length > 0) && !isDisabled && !isDelegate && !isLinkRoot && (role == null || SWIPE_ROLES.has(role));
const isCommit = swipeBehavior === 'commit';
const panels = hasSwipe
  ? (['leading', 'trailing'] as const).map((side) => ({side, entries: side === 'leading' ? leading : trailing})).filter((p) => p.entries.length > 0)
  : [];

// The label column: plain span (role / delegate / static), invisible link, or invisible button.
type ContentKind = 'span' | 'link' | 'disabled-link' | 'button';
const contentKind: ContentKind = hasParentRole || isDelegate
  ? 'span'
  : href != null && !isLinkRoot
    ? (isDisabled ? 'disabled-link' : 'link')
    : hasOnClick ? 'button' : 'span';
const ContentLink = contentKind === 'link' && safe != null ? resolveLinkComponent(undefined, Astro) : 'a';

// Whole-row activation (behaviors/clickable.ts).
const clickableMode = isDisabled || hasParentRole || isLinkRoot
  ? undefined
  : isDelegate ? 'delegate' : contentKind === 'link' && safe != null ? 'proxy' : contentKind === 'button' ? 'button' : undefined;

const {themeClass, attrs: themeAttrs} = themeProps('item', {
  density,
  align,
  highlighted: isHighlighted ? 'highlighted' : null,
  selected: isSelected ? 'selected' : null,
  disabled: isDisabled ? 'disabled' : null,
});
const callerAriaCurrent = (rest as Record<string, unknown>)['aria-current'];
const rootAttrs: Record<string, unknown> = {
  ...rest,
  ...(isLinkRoot ? {href: safe, target: isDisabled ? undefined : target, rel: isDisabled ? undefined : rel} : {}),
  role,
  'aria-selected': (allowsAriaSelected && isSelected) || undefined,
  'aria-current': callerAriaCurrent ?? (isSelected && !allowsAriaSelected ? 'true' : undefined),
  'aria-disabled': isDisabled || undefined,
  ...themeAttrs,
  class: cx(
    themeClass,
    'ax-focus-within',
    isInteractive && (hasStateFill ? 'ax-overlay-image' : 'ax-overlay-bg'),
    className as string | undefined,
  ),
  style: mergeStyles(style as StyleValue),
  'data-ax-interactive': isInteractive ? '' : undefined,
  'data-ax-link-root': isLinkRoot ? '' : undefined,
  'data-ax-parent-role': hasParentRole ? '' : undefined,
  'data-ax-swipe': hasSwipe ? '' : undefined,
  'data-ax-list-row': isListRow ? '' : undefined,
  'data-ax-clickable': clickableMode,
  'data-ax-clickable-target': isDelegate ? interactiveRef : undefined,
};

const contentAttrs: Record<string, unknown> = {
  class: cx(contentKind === 'span' ? 'ax-item-content' : 'ax-item-action'),
  'data-ax-inline': isInline ? '' : undefined,
  'data-ax-dimmed': isDisabled ? '' : undefined,
};
if (contentKind === 'button') Object.assign(contentAttrs, {type: 'button', disabled: isDisabled || undefined, 'data-ax-clickable-action': ''});
if (contentKind === 'link') Object.assign(contentAttrs, {href: safe, target, rel, 'data-ax-clickable-action': ''});
if (contentKind === 'disabled-link') Object.assign(contentAttrs, {role: 'link', 'aria-disabled': 'true', tabindex: -1});
const ContentTag = contentKind === 'button' ? 'button' : contentKind === 'link' ? ContentLink : contentKind === 'disabled-link' ? 'a' : 'span';

const clampStyle = (lines: number | undefined) => (lines != null && lines > 1 ? `--_ax-lines:${lines}` : undefined);
const firstLine = align === 'first-line' ? '' : undefined;
---
<Root {...rootAttrs}>
  {markerHtml !== '' && <Fragment set:html={markerHtml} />}
  {hasMarkerColumns && markerHtml !== '' ? (
    <span class="ax-item-marker-content">
      {startHtml !== '' && <span class="ax-item-start" data-ax-first-line={firstLine}><Fragment set:html={startHtml} /></span>}
      <ContentTag {...contentAttrs}>
        <span class="ax-item-label" data-ax-truncate={labelTruncate} style={clampStyle(labelLines)}>{labelSlot !== '' ? <Fragment set:html={labelSlot} /> : label}</span>
        {hasDescription && <span class="ax-item-description" id={descriptionId} data-ax-truncate={descriptionTruncate} style={clampStyle(descriptionLines)}>{descriptionSlot !== '' ? <Fragment set:html={descriptionSlot} /> : description}</span>}
      </ContentTag>
      {endHtml !== '' && <span class="ax-item-end" data-ax-first-line={firstLine} data-ax-dimmed={isDisabled ? '' : undefined}><Fragment set:html={endHtml} /></span>}
    </span>
  ) : (
    <Fragment>
      {startHtml !== '' && <span class="ax-item-start" data-ax-first-line={firstLine}><Fragment set:html={startHtml} /></span>}
      <ContentTag {...contentAttrs}>
        <span class="ax-item-label" data-ax-truncate={labelTruncate} style={clampStyle(labelLines)}>{labelSlot !== '' ? <Fragment set:html={labelSlot} /> : label}</span>
        {hasDescription && <span class="ax-item-description" id={descriptionId} data-ax-truncate={descriptionTruncate} style={clampStyle(descriptionLines)}>{descriptionSlot !== '' ? <Fragment set:html={descriptionSlot} /> : description}</span>}
      </ContentTag>
      {endHtml !== '' && <span class="ax-item-end" data-ax-first-line={firstLine} data-ax-dimmed={isDisabled ? '' : undefined}><Fragment set:html={endHtml} /></span>}
    </Fragment>
  )}
  {panels.map(({side, entries}) => {
    const outer = entries[entries.length - 1];
    const panel = themeProps('item-swipe-panel', {side});
    return (
      <div class={panel.themeClass} {...panel.attrs} data-swipe-panel={side} data-ax-variant={outer.variant ?? 'accent'} inert aria-hidden={isCommit ? 'true' : undefined}>
        <div class="ax-item-swipe-entries">
          {entries.map((entry) => {
            const variant = entry.variant ?? 'accent';
            const action = themeProps('item-swipe-action', {variant});
            const Entry = isCommit ? 'span' : 'button';
            return (
              <Entry
                class={cx(action.themeClass, !isCommit && 'ax-focus-visible')}
                {...action.attrs}
                type={isCommit ? undefined : 'button'}
                data-ax-swipe-id={entry.id ?? entry.label}
                data-ax-dimmed={entry.isDisabled ? '' : undefined}
                aria-disabled={!isCommit && entry.isDisabled ? 'true' : undefined}
                data-ax-disabled-interaction={!isCommit && entry.isDisabled ? '' : undefined}
              >
                {entry.icon != null && <Icon icon={entry.icon} />}
                <span>{entry.label}</span>
              </Entry>
            );
          })}
        </div>
      </div>
    );
  })}
</Root>
{clickableMode && <script>import '../../behaviors/clickable';</script>}
