---
import Lightbox from './Lightbox.astro';
import {lightboxTriggerProps} from './trigger';
import clip from './demo-clip.webm?inline';

// No external images: each "photo" is an inline SVG scene as a data URI.
const scene = (sky: [string, string], ground: string, sun: string, label: string, w = 1600, h = 1000) =>
  'data:image/svg+xml;utf8,' + encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}">` +
    `<defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${sky[0]}"/><stop offset="1" stop-color="${sky[1]}"/></linearGradient></defs>` +
    `<rect width="${w}" height="${h}" fill="url(#s)"/><circle cx="${w * 0.72}" cy="${h * 0.32}" r="${h * 0.1}" fill="${sun}"/>` +
    `<path d="M0 ${h * 0.72} L${w * 0.22} ${h * 0.46} L${w * 0.4} ${h * 0.66} L${w * 0.6} ${h * 0.4} L${w} ${h * 0.7} L${w} ${h} L0 ${h}Z" fill="${ground}" opacity="0.85"/>` +
    `<text x="${w / 2}" y="${h * 0.9}" font-family="sans-serif" font-size="${h * 0.06}" fill="white" text-anchor="middle">${label}</text></svg>`,
  );
const photos = [
  {src: scene(['#4f7cff', '#bcd2ff'], '#2f5d3a', '#ffe08a', 'Harbour at noon'), alt: 'Harbour at noon', caption: 'The harbour seen from the old lighthouse.'},
  {src: scene(['#ff8a5c', '#ffd2a8'], '#5a3d2b', '#fff2c4', 'Dunes at dusk'), alt: 'Dunes at dusk', caption: 'Late light over the dunes.'},
  {src: scene(['#1b1f4b', '#4b4f9b'], '#14162e', '#e8e8ff', 'Night ridge'), alt: 'Night ridge'},
  {src: scene(['#7fd1c7', '#e4fbf6'], '#3b7a57', '#fffbe0', ''), alt: ''},
];
const gallery = [...photos, {src: clip, alt: 'Test pattern clip', type: 'video' as const, caption: 'A two-second test pattern (video item).'}];
const thumb = 'display:block;width:120px;height:75px;object-fit:cover;border-radius:var(--radius-element);cursor:zoom-in';
const btn = 'font:inherit;font-size:var(--font-size-sm);padding:var(--spacing-1) var(--spacing-3);border:1px solid var(--color-border);border-radius:var(--radius-element);background:var(--color-background-surface);color:var(--color-text-primary);cursor:pointer';
const cap = 'margin:0 0 var(--spacing-2);font-size:var(--font-size-sm);color:var(--color-text-secondary)';
const out = 'margin:var(--spacing-2) 0 0;font-size:var(--font-size-sm);color:var(--color-text-primary);font-family:var(--font-family-code)';
---
<div style="display:grid;gap:var(--spacing-5)">
  <div>
    <p style={cap}>Gallery (5 items incl. a video), hasZoom — thumbnails are useLightbox triggers</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-2)">
      {gallery.map((item, i) => item.type === 'video'
        ? <button type="button" style={btn} data-ax-lightbox="lb-gallery" data-ax-lightbox-index={String(i)} id={`lb-thumb-${i}`}>▶ Video</button>
        : <img src={item.src} alt={item.alt || `Photo ${i + 1}`} style={thumb} id={`lb-thumb-${i}`} {...lightboxTriggerProps('lb-gallery', i)} />)}
    </div>
    <p style={out} data-lightbox-log>—</p>
    <Lightbox id="lb-gallery" media={gallery} hasZoom />
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-3);align-items:center">
    <button type="button" style={btn} id="lb-single-open" data-ax-lightbox="lb-single">Single image</button>
    <Lightbox id="lb-single" media={photos[1]} />
    <button type="button" style={btn} id="lb-video-open" data-ax-lightbox="lb-video">Single video (hasAutoPlay)</button>
    <Lightbox id="lb-video" media={{src: clip, alt: 'Test pattern clip', type: 'video'}} hasAutoPlay />
    <span dir="rtl" lang="he"><button type="button" style={btn} id="lb-rtl-open" data-ax-lightbox="lb-rtl" data-ax-lightbox-index="1">RTL gallery (he-IL)</button>
    <Lightbox id="lb-rtl" media={photos} locale="he-IL" /></span>
  </div>
</div>
<script>
  const log = document.querySelector<HTMLElement>('[data-lightbox-log]');
  const box = document.getElementById('lb-gallery');
  box?.addEventListener('astryx-open-change', (e) => { if (log) log.textContent = `open: ${(e as CustomEvent).detail.isOpen}`; });
  box?.addEventListener('astryx-index-change', (e) => { if (log) log.textContent = `index: ${(e as CustomEvent).detail.index}`; });
</script>
