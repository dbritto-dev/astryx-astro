---
/**
 * One MultiSelector option row (MultiSelector.tsx renderItem): `role="option"` with the
 * `multi-selector-option` theme target (size, select-all, selected, disabled), a decorative
 * checkbox at either edge and the label (or `renderOption`'s content). The select-all row's
 * partial state is spoken through its name (`aria-label`), since aria-selected has no "mixed".
 *
 * The checkbox is Astryx's: an inert `<div>` holding a CheckboxInput (`label=""`,
 * `isLabelHidden`, sm for sm rows, else md), so `.astryx-checkbox-input[data-size]` and the
 * CheckboxInput theme targets apply here too. `<ax-multi-selector>` sets its `value` in place
 * as the selection changes (`data-ax-mark-state` mirrors it).
 */
import CheckboxInput from '../CheckboxInput/CheckboxInput.astro';
import type {SelectorOptionData} from '../Selector/options';

export interface Props {
  option: SelectorOptionData & {label: string};
  id: string;
  /** Original position, restored when the list closes (selected rows move first on open). */
  order?: number;
  isSelected: boolean;
  /** Checkbox state (select-all is tri-state). @default isSelected ? 'checked' : 'unchecked' */
  markState?: 'checked' | 'unchecked' | 'indeterminate';
  isSelectAll?: boolean;
  /** The select-all row's name while partially selected. */
  partialLabel?: string;
  size: 'sm' | 'md' | 'lg';
  indicatorPosition: 'start' | 'end';
  content?: unknown;
  hidden?: boolean;
  /** The MultiSelector box's id while its size is inherited: a size provider's stamp reaches the row (and its checkbox, lg → md) too. */
  sizeFrom?: string;
}

const {option, id, order, isSelected, markState, isSelectAll = false, partialLabel, size, indicatorPosition, content, hidden = false, sizeFrom} = Astro.props;
const isDisabled = !!option.disabled;
const state = markState ?? (isSelected ? 'checked' : 'unchecked');
const checkboxSize = size === 'lg' ? 'md' : size;
const mark = `${state}${isDisabled ? '-disabled' : ''}`;
const checkboxValue = state === 'indeterminate' ? 'indeterminate' : state === 'checked';
// The checkbox's parts follow the inherited size too (CheckboxInput has no lg: lg → md).
const followCheckbox = sizeFrom ? {'data-ax-inherit-from': sizeFrom, 'data-ax-inherit-map': 'lg=md', 'data-ax-inherit-deep': ''} : {};
---
<div
  role="option"
  id={id || undefined}
  aria-selected={isSelected ? 'true' : 'false'}
  aria-disabled={isDisabled ? 'true' : undefined}
  aria-label={isSelectAll && state === 'indeterminate' ? partialLabel : undefined}
  data-value={option.value}
  data-ax-label={option.label}
  data-ax-order={order}
  data-ax-select-all-row={isSelectAll ? '' : undefined}
  data-ax-fixed={isSelectAll ? '' : undefined}
  data-ax-partial-label={isSelectAll ? partialLabel : undefined}
  data-ax-mark-state={mark}
  class="astryx-multi-selector-option"
  data-size={size}
  data-ax-inherit-from={sizeFrom}
  data-select-all={isSelectAll ? 'select-all' : undefined}
  data-selected={isSelected ? 'selected' : undefined}
  data-disabled={isDisabled ? 'disabled' : undefined}
  hidden={hidden || undefined}
>
  {indicatorPosition === 'start' && <div class="ax-multi-selector-check" inert data-ax-mark-slot {...followCheckbox}><CheckboxInput label="" isLabelHidden value={checkboxValue} isDisabled={isDisabled} size={checkboxSize} /></div>}
  {content != null && !isSelectAll ? content : <span class="ax-multi-selector-label">{option.label}</span>}
  {indicatorPosition === 'end' && <div class="ax-multi-selector-check ax-multi-selector-check-end" inert data-ax-mark-slot {...followCheckbox}><CheckboxInput label="" isLabelHidden value={checkboxValue} isDisabled={isDisabled} size={checkboxSize} /></div>}
</div>
