---
/**
 * NavHeadingMenuItem — one row of a NavHeadingMenu: an action (`<div role="menuitem">`) or a
 * destination (`href`: the row is the anchor, through LinkProvider and the safe-URL check).
 * Port of @astryxdesign/core NavMenu/NavHeadingMenuItem.tsx.
 * Theme target: `.astryx-nav-heading-menu-item[data-size]` (the menu's size, md outside one).
 *
 * `tabindex="-1"` (the menu roves focus); a disabled row is `aria-disabled`, keeps focus but
 * never acts, and a disabled link row drops its `href` (no middle-click / open-in-new-tab
 * destination; AST-085 FR2). A focused or hovered row paints the hover overlay. Link rows are
 * not draggable. Astryx `onClick` is the row's native `click` (Enter / Space click it too);
 * the heading's popover closes after a row acts when the heading says so.
 *
 * Slots: `icon` (markup instead of the `icon` prop), `label`, `description`.
 *
 * @example
 * <NavHeadingMenuItem label="Settings" icon="wrench" description="Workspace preferences" />
 */
import type {HTMLAttributes} from 'astro/types';
import Icon from '../Icon/Icon.astro';
import Text from '../Text/Text.astro';
import NavLink from '../NavItem/_NavLink.astro';
import type {AstroIconComponent, ExtendedIconName} from '../Icon/iconRegistry';
import type {LinkComponentType} from '../LinkProvider/linkComponent';
import {cx, themeProps} from '../../lib/themeProps';
import {NAV_HEADING_MENU_SIZE_KEY, type NavHeadingMenuSize} from './navMenuShared';
import './NavMenu.css';

export interface Props extends Omit<HTMLAttributes<'div'>, 'role' | 'tabindex'> {
  /** Primary label (or the `label` slot). */
  label?: string;
  /** Secondary text below the label (or the `description` slot). */
  description?: string;
  /** Icon before the label: a name, SVG string or Astro component (or the `icon` slot). */
  icon?: ExtendedIconName | AstroIconComponent;
  /** Destination: the row renders as the anchor. */
  href?: string | URL;
  /** Link component for the row (overrides LinkProvider). */
  as?: LinkComponentType;
  /** @default false */
  isDisabled?: boolean;
  /** @internal The size outside a NavHeadingMenu (inside one the menu stamps it). @default 'md' */
  size?: NavHeadingMenuSize;
  'data-testid'?: string;
}

const {label, description, icon, href, as, isDisabled = false, size, class: className, slot: _slot, ...rest} = Astro.props as Props & {slot?: unknown};
const slot = async (name: string) => (Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : '');
const iconHtml = await slot('icon');
const labelHtml = await slot('label');
const descriptionHtml = await slot('description');
const {themeClass, attrs} = themeProps('nav-heading-menu-item', {size: size ?? 'md'});
const isLink = href != null;
const common = {
  ...rest,
  role: 'menuitem',
  // A disabled action row is still in the tree but takes no focus; a disabled link row keeps
  // tabindex -1 so it stays focusable once its href is gone.
  tabindex: isDisabled && !isLink ? undefined : -1,
  'aria-disabled': isDisabled ? 'true' : undefined,
  draggable: isLink ? 'false' : undefined,
  class: cx(themeClass, className as string | undefined),
  ...attrs,
  'data-ax-inherit': size == null ? NAV_HEADING_MENU_SIZE_KEY : undefined,
  'data-ax-disabled-interaction': isDisabled ? '' : undefined,
};
const hasDescription = descriptionHtml !== '' || (description != null && description !== '');
---
{isLink && !isDisabled ? (
  <NavLink {...common} href={href} as={as}>
    {iconHtml !== '' ? <Fragment set:html={iconHtml} /> : icon != null && <Icon icon={icon} size="sm" color="secondary" />}
    <span class="ax-nav-heading-menu-item-content">
      {labelHtml !== '' ? <Fragment set:html={labelHtml} /> : <Text type="body" maxLines={1}>{label}</Text>}
      {hasDescription && (descriptionHtml !== '' ? <Text type="supporting" maxLines={1}><Fragment set:html={descriptionHtml} /></Text> : <Text type="supporting" maxLines={1}>{description}</Text>)}
    </span>
  </NavLink>
) : isLink ? (
  <a {...common}>
    {iconHtml !== '' ? <Fragment set:html={iconHtml} /> : icon != null && <Icon icon={icon} size="sm" color="secondary" />}
    <span class="ax-nav-heading-menu-item-content">
      {labelHtml !== '' ? <Fragment set:html={labelHtml} /> : <Text type="body" maxLines={1}>{label}</Text>}
      {hasDescription && (descriptionHtml !== '' ? <Text type="supporting" maxLines={1}><Fragment set:html={descriptionHtml} /></Text> : <Text type="supporting" maxLines={1}>{description}</Text>)}
    </span>
  </a>
) : (
  <div {...common}>
    {iconHtml !== '' ? <Fragment set:html={iconHtml} /> : icon != null && <Icon icon={icon} size="sm" color="secondary" />}
    <span class="ax-nav-heading-menu-item-content">
      {labelHtml !== '' ? <Fragment set:html={labelHtml} /> : <Text type="body" maxLines={1}>{label}</Text>}
      {hasDescription && (descriptionHtml !== '' ? <Text type="supporting" maxLines={1}><Fragment set:html={descriptionHtml} /></Text> : <Text type="supporting" maxLines={1}>{description}</Text>)}
    </span>
  </div>
)}
<script>import '../../elements/runtime/disabledInteraction';</script>
