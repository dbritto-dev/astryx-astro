---
/**
 * SideNavHeading — the product / suite / account heading for SideNav's `header` slot: icon,
 * superheading, heading, subheading, trailing content and an optional menu popover.
 * Port of @astryxdesign/core SideNav/SideNavHeading.tsx (usePopover role none + useMenuHover with
 * no delay, NavHeadingCloseContext / NavHeadingDismissContext, the collapsed rail form).
 * Theme target: `.astryx-side-nav-heading`.
 *
 * Interaction boundaries as TopNavHeading: `headingHref` alone makes the whole heading one link
 * (a row holding the link and `headerEndContent` side by side when there is end content); links
 * without a menu link independently; a menu without links makes the whole heading the trigger
 * (the chevron `<button>` is named "{heading}, Open menu"); a menu with links keeps them
 * independent. The menu (`menu` slot, usually a NavHeadingMenu) opens in a popover laid over the
 * heading (a copy of the heading at its top closes it), `role="menu"` named by `heading`; its rows
 * do not close it (Astryx NavHeadingDismissContext) — Escape, the copy or a press outside do.
 *
 * Collapsed rail: the icon alone (a link named by `heading` with `headingHref`, the menu trigger
 * with a menu — the popover then opens below it and closes after a row acts — else a plain box),
 * with `heading` in a tooltip on the end side; without an icon the heading leaves the rail.
 *
 * Slots: `icon` (NavIcon …), `headerEndContent` (hidden in the rail), `menu`.
 *
 * @example
 * <SideNavHeading slot="header" heading="Acme" subheading="Business account">
 *   <NavIcon slot="icon" icon="wrench" />
 *   <NavHeadingMenu slot="menu"><NavHeadingMenuItem label="Switch account" /></NavHeadingMenu>
 * </SideNavHeading>
 */
import type {HTMLAttributes} from 'astro/types';
import Icon from '../Icon/Icon.astro';
import Link from '../Link/Link.astro';
import Tooltip from '../Tooltip/Tooltip.astro';
import NavLink from '../NavItem/_NavLink.astro';
import NavMenuLayer from '../NavMenu/_NavMenuLayer.astro';
import type {LinkComponentType} from '../LinkProvider/linkComponent';
import {cx, themeProps} from '../../lib/themeProps';
import {translator} from '../../lib/i18n';
import {uid} from '../../lib/uid';
import {sideNavContext} from './sideNavContext';
import '../NavItem/NavItem.css';
import '../NavMenu/NavMenu.css';
import '../NavMenu/NavHeading.css';
import './SideNav.css';

export interface Props extends HTMLAttributes<'div'> {
  /** Product / app name. */
  heading: string;
  headingHref?: string | URL;
  superheading?: string;
  superheadingHref?: string | URL;
  subheading?: string;
  subheadingHref?: string | URL;
  /** Link component (overrides LinkProvider). */
  as?: LinkComponentType;
  locale?: string;
  'data-testid'?: string;
}

const {
  heading, headingHref, superheading, superheadingHref, subheading, subheadingHref, as, locale,
  class: className, id: idProp, slot: _slot, ...rest
} = Astro.props as Props & {slot?: unknown};
const t = translator(Astro, locale);
const nav = sideNavContext(Astro);
const slot = async (name: string) => (Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : '');
const iconHtml = await slot('icon');
const endHtml = await slot('headerEndContent');
const menuHtml = await slot('menu');
const hasIcon = iconHtml !== '';
const hasMenu = menuHtml !== '';
const hasAnyHref = headingHref != null || superheadingHref != null || subheadingHref != null;
const hasCompact = !!(superheading || subheading);
const isWholeTrigger = hasMenu && !hasAnyHref;
const isWholeLink = headingHref != null && !hasMenu && superheadingHref == null && subheadingHref == null;
const {themeClass, attrs} = themeProps('side-nav-heading');
const rootClass = cx(themeClass, 'ax-nav-heading', className as string | undefined);
const baseId = uid(Astro, 'ax-side-nav-heading');
const rootId = (idProp as string | undefined) ?? (hasMenu ? `${baseId}-root` : undefined);
const layerId = `${baseId}-menu`;
const chevronId = `${baseId}-trigger`;
const openLabel = t('@astryx.sideNav.heading.openMenu', {heading});
const mode = isWholeLink ? (endHtml !== '' ? 'link-row' : 'link') : isWholeTrigger ? 'trigger' : hasMenu ? 'mixed' : hasAnyHref ? 'links' : 'static';
// The rail form (a collapsible SideNav).
const hasRail = nav.isCollapsible;
const railId = `${baseId}-rail`;
const railLayerId = `${baseId}-rail-menu`;
const railTip = hasRail && hasIcon ? `${baseId}-tip` : undefined;
const titleClass = cx('ax-heading-title', hasCompact && 'ax-heading-title-compact');
---
<div class="ax-side-nav-heading-host" data-ax-rail={hasRail ? (hasIcon ? 'split' : 'hide') : undefined}>
  <div class="ax-side-nav-expanded-part">
    {mode === 'link' ? (
      <NavLink {...rest} id={rootId} href={headingHref} as={as} class={cx(rootClass, 'ax-heading-whole-link ax-focus-visible')} {...attrs}>
        {hasIcon && <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>}
        <span class="ax-heading-text">
          {superheading && <span class="ax-heading-super">{superheading}</span>}
          <span class="ax-heading-row"><span class={titleClass}>{heading}</span></span>
          {subheading && <span class="ax-heading-sub">{subheading}</span>}
        </span>
      </NavLink>
    ) : mode === 'link-row' ? (
      <div {...rest} id={rootId} class={rootClass} {...attrs}>
        <NavLink href={headingHref} as={as} class="ax-heading-link-beside-end ax-focus-visible">
          {hasIcon && <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>}
          <span class="ax-heading-text">
            {superheading && <span class="ax-heading-super">{superheading}</span>}
            <span class="ax-heading-row"><span class={titleClass}>{heading}</span></span>
            {subheading && <span class="ax-heading-sub">{subheading}</span>}
          </span>
        </NavLink>
        <span class="ax-heading-end"><Fragment set:html={endHtml} /></span>
      </div>
    ) : mode === 'trigger' || mode === 'mixed' ? (
      <Fragment>
        <div {...rest} id={rootId} class={cx(rootClass, mode === 'trigger' && 'ax-heading-menu-trigger')} {...attrs}>
          {hasIcon && (mode === 'mixed' && headingHref != null
            ? <NavLink href={headingHref} as={as} aria-label={heading} class="ax-heading-logo ax-focus-visible"><Fragment set:html={iconHtml} /></NavLink>
            : <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>)}
          <span class="ax-heading-text">
            {superheading && (mode === 'mixed' && superheadingHref != null
              ? <Link href={superheadingHref} color="secondary" size="xsm">{superheading}</Link>
              : <span class="ax-heading-super">{superheading}</span>)}
            <span class="ax-heading-row">
              {mode === 'mixed' && headingHref != null
                ? <NavLink href={headingHref} as={as} class={cx(titleClass, 'ax-heading-title-link ax-focus-visible')}>{heading}</NavLink>
                : <span class={titleClass}>{heading}</span>}
              <button type="button" id={chevronId} class="ax-heading-chevron ax-heading-chevron-button ax-focus-visible" aria-label={openLabel} popovertarget={layerId} aria-haspopup="true" aria-expanded="false" aria-controls={layerId}>
                <Icon icon="chevronDown" size="sm" color="inherit" class="ax-heading-chevron-glyph" />
              </button>
            </span>
            {subheading && (mode === 'mixed' && subheadingHref != null
              ? <Link href={subheadingHref} color="secondary" size="xsm">{subheading}</Link>
              : <span class="ax-heading-sub">{subheading}</span>)}
          </span>
          {endHtml !== '' && <span class="ax-heading-end"><Fragment set:html={endHtml} /></span>}
        </div>
        <NavMenuLayer id={layerId} triggerId={chevronId} anchorId={rootId} hoverAreaId={rootId} placement="below" alignment="start" showDelay={0} layerClass="ax-heading-menu-layer">
          <div class="ax-heading-popover-content">
            <button type="button" class="ax-heading-popover-heading ax-focus-visible" data-ax-nav-menu-close="">
              {hasIcon && <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>}
              <span class="ax-heading-text">
                {superheading && <span class="ax-heading-super">{superheading}</span>}
                <span class="ax-heading-row">
                  <span class={titleClass}>{heading}</span>
                  <Icon icon="chevronDown" size="sm" color="secondary" class="ax-heading-chevron ax-heading-chevron-glyph ax-heading-chevron-flipped" />
                </span>
                {subheading && <span class="ax-heading-sub">{subheading}</span>}
              </span>
            </button>
            <div role="menu" aria-label={heading} class="ax-heading-menu"><Fragment set:html={menuHtml} /></div>
          </div>
        </NavMenuLayer>
      </Fragment>
    ) : mode === 'links' ? (
      <div {...rest} id={rootId} class={rootClass} {...attrs}>
        {hasIcon && (headingHref != null
          ? <NavLink href={headingHref} as={as} aria-label={heading} class="ax-heading-logo ax-focus-visible"><Fragment set:html={iconHtml} /></NavLink>
          : <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>)}
        <span class="ax-heading-text">
          {superheading && (superheadingHref != null ? <Link href={superheadingHref} color="secondary" size="xsm">{superheading}</Link> : <span class="ax-heading-super">{superheading}</span>)}
          {headingHref != null ? <Link href={headingHref} color="primary" weight="semibold">{heading}</Link> : <span class={titleClass}>{heading}</span>}
          {subheading && (subheadingHref != null ? <Link href={subheadingHref} color="secondary" size="xsm">{subheading}</Link> : <span class="ax-heading-sub">{subheading}</span>)}
        </span>
        {endHtml !== '' && <span class="ax-heading-end"><Fragment set:html={endHtml} /></span>}
      </div>
    ) : (
      <div {...rest} id={rootId} class={rootClass} {...attrs}>
        {hasIcon && <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>}
        <span class="ax-heading-text">
          {superheading && <span class="ax-heading-super">{superheading}</span>}
          <span class="ax-heading-row"><span class={titleClass}>{heading}</span></span>
          {subheading && <span class="ax-heading-sub">{subheading}</span>}
        </span>
        {endHtml !== '' && <span class="ax-heading-end"><Fragment set:html={endHtml} /></span>}
      </div>
    )}
  </div>
  {hasRail && hasIcon && (
    <div class="ax-side-nav-rail-part">
      {headingHref != null ? (
        <NavLink id={railId} href={headingHref} as={as} aria-label={heading} class={cx(themeClass, 'ax-nav-item ax-overlay-bg ax-focus-visible ax-side-nav-heading-rail')} {...attrs} data-ax-nav-size="md" data-ax-tooltip={railTip} data-ax-rail-control="">
          <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>
        </NavLink>
      ) : hasMenu ? (
        <Fragment>
          <button type="button" id={railId} aria-label={heading} class={cx(themeClass, 'ax-nav-item ax-overlay-bg ax-focus-visible ax-side-nav-heading-rail ax-heading-menu-trigger')} {...attrs} data-ax-nav-size="md" popovertarget={railLayerId} aria-haspopup="true" aria-expanded="false" aria-controls={railLayerId} data-ax-tooltip={railTip} data-ax-rail-control="">
            <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>
          </button>
          <NavMenuLayer id={railLayerId} triggerId={railId} placement="below" alignment="start" showDelay={0} closeOnSelect layerClass="ax-heading-flyout-layer">
            <div class="ax-heading-popover-content">
              <button type="button" class="ax-heading-popover-heading ax-focus-visible" data-ax-nav-menu-close="">
                <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>
                <span class="ax-heading-text">
                  {superheading && <span class="ax-heading-super">{superheading}</span>}
                  <span class="ax-heading-row">
                    <span class={titleClass}>{heading}</span>
                    <Icon icon="chevronDown" size="sm" color="secondary" class="ax-heading-chevron ax-heading-chevron-glyph ax-heading-chevron-flipped" />
                  </span>
                  {subheading && <span class="ax-heading-sub">{subheading}</span>}
                </span>
              </button>
              <div role="menu" aria-label={heading} class="ax-heading-menu"><Fragment set:html={menuHtml} /></div>
            </div>
          </NavMenuLayer>
        </Fragment>
      ) : (
        <div id={railId} class={cx(themeClass, 'ax-nav-heading ax-side-nav-heading-rail-static')} {...attrs} data-ax-tooltip={railTip}>
          <span class="ax-heading-logo"><Fragment set:html={iconHtml} /></span>
        </div>
      )}
      <Tooltip id={railTip} content={heading} placement="end" />
    </div>
  )}
</div>
