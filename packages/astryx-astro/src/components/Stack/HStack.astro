---
/** HStack — horizontal Stack. `justify` = horizontal, `align` = vertical alignment. */
import Stack, {type Props as StackProps} from './Stack.astro';

export type Props = Omit<StackProps, 'direction'>;
const {justify, align, hAlign, vAlign, slot: _slot, ...rest} = Astro.props as typeof Astro.props & {slot?: string};
---
<Stack {...rest} direction="horizontal" hAlign={hAlign ?? justify} vAlign={vAlign ?? align}><slot /></Stack>
