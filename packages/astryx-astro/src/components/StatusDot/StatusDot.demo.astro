---
import StatusDot, {type StatusDotVariant} from './StatusDot.astro';
const variants: StatusDotVariant[] = ['success', 'warning', 'error', 'accent', 'neutral'];
const labels: Record<string, string> = {success: 'Online', warning: 'Degraded', error: 'Offline', accent: 'Selected', neutral: 'Idle'};
const icons: Record<string, string> = {success: 'check', warning: 'warning', error: 'close', accent: 'info', neutral: 'clock'};
const item = 'display:inline-flex;align-items:center;gap:var(--spacing-2);font-size:var(--font-size-sm)';
const row = 'display:flex;flex-wrap:wrap;align-items:center;gap:var(--spacing-5)';
---
<div style="display:grid;gap:var(--spacing-4);color:var(--color-text-primary)">
  <div style={row}>{variants.map((v) => <span style={item}><StatusDot variant={v} label={labels[v]} />{labels[v]}</span>)}</div>
  <div style={row}>{variants.map((v) => <span style={item}><StatusDot variant={v} label={`${labels[v]}, live`} isPulsing />pulsing</span>)}</div>
  <div style={row}>{variants.map((v) => <span style={item}><StatusDot variant={v} label={labels[v]} icon={icons[v]} />icon “{icons[v]}”</span>)}</div>
  <div style={row}>
    <span style={item}><StatusDot variant="success" label="Online" tooltip="Connected to the build server" />with tooltip</span>
    <span style={item}><StatusDot variant="error" label="Failed"><svg slot="icon" viewBox="0 0 8 8" width="8" height="8" fill="currentColor"><rect x="3.25" y="1.5" width="1.5" height="5" rx="0.75"></rect></svg></StatusDot>icon slot</span>
  </div>
</div>
