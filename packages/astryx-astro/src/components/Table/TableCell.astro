---
/**
 * TableCell — a `<td>` for children-mode Tables. Port of @astryxdesign/core
 * Table/TableCell.tsx (+ table.stylex.ts, useTableCellStyles.ts).
 *
 * Inside a Table it takes the table's density padding, divider borders, vertical alignment
 * and text overflow: the Table stamps the effective `data-density` onto it (cascade key
 * `table-density`), the rest follows from the table's attributes. Standalone it renders a
 * plain `<td>`. Theme hook: `.astryx-table-cell[data-density]`.
 *
 * `scope` (Astryx: "used on `<td>` acting as a row header") renders a `<th>`. Deviation from
 * Astryx (accessibility, docs/accessibility.md): HTML allows `scope` only on `<th>`, so on a
 * `<td>` it is ignored and the row has no header. The cell keeps a data cell's look (Table.css).
 *
 * `contextMenuActions` (Astryx wrapInTableContextMenu): the content sits in a ContextMenu
 * trigger that fills the cell and carries the density padding (moved off the `<td>`), so a
 * right-click anywhere in the cell opens the menu. Choosing a row dispatches `astryx-select`
 * on it, its `data-id` the action's `id` (`onSelect` is not called; a getter resolves on the
 * server). Empty or omitted: no menu, the browser's own passes through.
 *
 * @example
 * <TableRow><TableCell>Alice</TableCell><TableCell colSpan={2}>Engineer</TableCell></TableRow>
 */
import type {HTMLAttributes} from 'astro/types';
import {cx, themeProps} from '../../lib/themeProps';
import ContextMenu from '../ContextMenu/ContextMenu.astro';
import {contextMenuItems} from './contextMenuOptions';
import type {TableContextActions} from './types';
import './Table.css';

export interface Props extends HTMLAttributes<'td'> {
  /** Makes the cell a header for its row (`row`) or row group: it renders a `<th>`. */
  scope?: 'col' | 'row' | 'colgroup' | 'rowgroup';
  /** Space-separated ids of the header cells describing this cell. */
  headers?: string;
  /** Columns spanned (Astryx name; `colspan` works too). */
  colSpan?: number;
  /** Rows spanned (Astryx name; `rowspan` works too). */
  rowSpan?: number;
  /** Right-click actions: a context menu around the cell content (empty: none). */
  contextMenuActions?: TableContextActions;
}

const {colSpan, rowSpan, contextMenuActions, class: className, slot: _slot, ...rest} = Astro.props as typeof Astro.props & {slot?: string};
const {themeClass} = themeProps('table-cell');
const menuItems = contextMenuItems(contextMenuActions);
const Tag = rest.scope ? 'th' : 'td';
---
<Tag
  {...rest}
  colspan={colSpan ?? rest.colspan}
  rowspan={rowSpan ?? rest.rowspan}
  class={cx(themeClass, menuItems && 'ax-table-context-cell', className)}
  data-ax-inherit="table-density"
>{menuItems ? (
  <ContextMenu items={menuItems} triggerClass="ax-table-context-trigger" data-ax-context-kind="body" data-ax-inherit="table-density"><slot /></ContextMenu>
) : <slot />}</Tag>
