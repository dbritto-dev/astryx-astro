---
/**
 * Thumbnail — a 64px square preview for an image attachment: skeleton while loading, the
 * image, or a placeholder when there is no image or it fails to load; an optional open
 * action and an overlaid remove button. Port of @astryxdesign/core Thumbnail/Thumbnail.tsx,
 * hooks/useContainerReveal.ts + containerReveal.stylex.ts and hooks/useBusyAnnouncement.ts.
 *
 * States: `isLoading` without `src` → Skeleton; `isLoading` with `src` → the image under a
 * scrim with an onMedia Spinner (the busy start is announced once: "Loading"); a failed
 * image swaps to the placeholder in the browser (behaviors/imageFallback.ts).
 *
 * Remove: revealed on hover (CSS), at once on keyboard focus inside the thumbnail, and
 * always on touch-capable devices (`showRemoveOn="hover"`, default), or always shown. It
 * sits on a fixed --color-overlay scrim with an --color-on-dark icon.
 *
 * Accessibility: `role="group"` named "{label} — {alt}" / label / alt / "Thumbnail". An image
 * without `alt` is decorative (alt="" + role="presentation" + aria-hidden). Open and Remove
 * stay mounted when they cannot act (disabled / loading): `aria-disabled="true"`, inert
 * (elements/runtime/disabledInteraction.ts cancels clicks and Enter/Space), so a focused one
 * keeps focus. A labelled thumbnail is wrapped in a Tooltip showing the label on hover (the
 * group root is the trigger; the layer is its next sibling).
 *
 * The remove control is `<Button variant="secondary" size="sm" isIconOnly>` with an xsm close
 * Icon and Thumbnail's overrides (fixed --color-overlay scrim, --color-on-dark icon, 20px).
 *
 * Events (Astryx callbacks → `isClickable` / `isRemovable` + DOM events, behaviors/thumbnail.ts),
 * dispatched on the thumbnail root (bubbles, composed), `detail: {event}` (the native click):
 *  - `isClickable` (Astryx `onClick`): renders the Open action; `astryx-click` while it can act;
 *  - `isRemovable` (Astryx `onRemove`): renders the Remove button; `astryx-remove`. The remove
 *    click goes no further than the button (Astryx stopPropagation), so it never opens.
 *
 * @example
 * <Thumbnail src="/photo.jpg" alt="Vacation photo" isRemovable />
 * <Thumbnail src="/preview.png" alt="Preview" label="preview.png" isClickable />
 * <Thumbnail isLoading label="upload.png" />
 */
import type {HTMLAttributes} from 'astro/types';
import Icon from '../Icon/Icon.astro';
import Skeleton from '../Skeleton/Skeleton.astro';
import Spinner from '../Spinner/Spinner.astro';
import Button from '../Button/Button.astro';
import Tooltip from '../Tooltip/Tooltip.astro';
import {attachTooltip} from '../Tooltip/attach';
import {cx, themeProps} from '../../lib/themeProps';
import {mergeStyles, type StyleValue} from '../../lib/style';
import {translator} from '../../lib/i18n';
import './Thumbnail.css';

export interface Props extends HTMLAttributes<'div'> {
  /** Image source. Skeleton while loading, the image on success, a placeholder on error. */
  src?: string;
  /** Alt text; omit for a decorative image. */
  alt?: string;
  /** Accessible label (e.g. the file name): names the group and the actions; shown in a Tooltip. */
  label?: string;
  /** Renders the overlaid remove button (Astryx `onRemove`); clicks dispatch `astryx-remove` {event}. @default false */
  isRemovable?: boolean;
  /** Renders the thumbnail as an open action (Astryx `onClick`); clicks dispatch `astryx-click` {event}. @default false */
  isClickable?: boolean;
  /** Skeleton (no src) or a busy scrim over the image (with src). @default false */
  isLoading?: boolean;
  /** @default false */
  isDisabled?: boolean;
  /** When the remove button shows. @default 'hover' */
  showRemoveOn?: 'always' | 'hover';
  'data-testid'?: string;
  /** Remove button name (port extension). @default translated "Remove {accessibleName}" */
  removeLabel?: string;
  /** Open action name (port extension). @default translated "Open {accessibleName}" */
  openLabel?: string;
  /** Locale for the default strings. */
  locale?: string;
}

const {
  src,
  alt,
  label,
  isRemovable = false,
  isClickable = false,
  isLoading = false,
  isDisabled = false,
  showRemoveOn = 'hover',
  'data-testid': testId,
  removeLabel,
  openLabel,
  locale,
  class: className,
  style,
  ...props
} = Astro.props;

const t = translator(Astro, locale);
const hasSrc = src != null;
const showSkeleton = isLoading && !hasSrc;
const showImage = hasSrc && !showSkeleton;
const showUploadOverlay = isLoading && hasSrc;
const showPlaceholder = !isLoading && !hasSrc;
const hasOpen = isClickable;
const isInteractive = hasOpen && !isDisabled && !isLoading;
const hasRemove = isRemovable;
const isHoverReveal = hasRemove && showRemoveOn === 'hover';
const accessibleName = label && alt ? `${label} — ${alt}` : (label ?? alt ?? t('@astryx.thumbnail.fallbackName'));
const isImageDecorative = !alt;

if (import.meta.env.DEV && hasSrc && alt == null && label == null && props['aria-label'] == null && props['aria-labelledby'] == null) {
  console.warn('[astryx Thumbnail] `src` is set without `alt` or `label`. The image is treated as decorative and hidden from assistive technology, and the thumbnail falls back to a generic "thumbnail" name. Pass `alt` to describe the image content, or `label` (file name) to name the thumbnail.');
}

const {themeClass} = themeProps('thumbnail');
const placeholderSvg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2M8.5 13.5l2.5 3 3.5-4.5 4.5 6H5l3.5-5.5z"></path></svg>';
// Astryx `if (label != null) <Tooltip content={label}>`: the wrapper describes the group root.
const tip = label != null ? attachTooltip({describedBy: props['aria-describedby'] as string | undefined}) : null;
const hasInert = (hasOpen && !isInteractive) || (hasRemove && isDisabled);
---
<div
  data-testid={testId}
  role="group"
  aria-label={accessibleName}
  class={cx(themeClass, className)}
  data-ax-disabled={isDisabled ? '' : undefined}
  data-ax-thumbnail={hasOpen || hasRemove ? '' : undefined}
  style={mergeStyles(style as StyleValue)}
  {...props}
  {...tip?.trigger}
><div
  class="ax-thumbnail-media ax-focus-within"
  data-ax-interactive={isInteractive ? '' : undefined}
  data-ax-reveal={isHoverReveal ? '' : undefined}
  data-ax-image-fallback={showImage ? '' : undefined}
>{(() => {
  const image = showImage && <img src={src} alt={alt ?? ''} role={isImageDecorative ? 'presentation' : undefined} aria-hidden={isImageDecorative ? 'true' : undefined} class="ax-thumbnail-image" data-ax-fallback-step="0" />;
  const fallback = showImage && <template data-ax-fallback-step="1"><div class="ax-thumbnail-placeholder" data-ax-fallback-step="1" set:html={placeholderSvg} /></template>;
  const content = <>{image}{fallback}{showSkeleton && <Skeleton radius={2} />}{showPlaceholder && <div class="ax-thumbnail-placeholder" set:html={placeholderSvg} />}</>;
  return hasOpen ? (
    <button
      type="button"
      class="ax-thumbnail-open"
      aria-label={openLabel ?? t('@astryx.thumbnail.open', {accessibleName})}
      aria-disabled={isInteractive ? undefined : 'true'}
    >{content}</button>
  ) : content;
})()}{showImage && <div class="ax-thumbnail-inset-border" data-ax-fallback-step="0"></div>}{showUploadOverlay && (
  <div class="ax-thumbnail-upload" data-ax-busy-announce={t('@astryx.spinner.loading')}><Spinner size="sm" shade="onMedia" aria-hidden="true" /></div>
)}{hasRemove && (
  <div class="ax-thumbnail-remove-slot" data-ax-reveal-content={isHoverReveal ? '' : undefined}><Button
    label={removeLabel ?? t('@astryx.thumbnail.remove', {accessibleName})}
    variant="secondary"
    size="sm"
    isIconOnly
    class="ax-thumbnail-remove"
    aria-disabled={isDisabled ? 'true' : undefined}
    data-ax-disabled-interaction={isDisabled ? '' : undefined}
    data-ax-thumbnail-remove
    locale={locale}
  ><Icon slot="icon" icon="close" size="xsm" /></Button></div>
)}</div></div>
{tip && <Tooltip {...tip.layer} content={label} />}
{showImage && <script>import '../../behaviors/imageFallback';</script>}
{showUploadOverlay && <script>import '../../behaviors/busyAnnounce';</script>}
{(hasOpen || hasRemove) && <script>import '../../behaviors/thumbnail';</script>}
{hasInert && <script>import '../../elements/runtime/disabledInteraction';</script>}
