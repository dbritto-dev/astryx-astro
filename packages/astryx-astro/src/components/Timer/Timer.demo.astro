---
import Timer from './Timer.astro';
import Text from '../Text/Text.astro';
import {Temporal} from '../../lib/temporal';
// Fixed offsets from build time would drift; the demo computes start times in the browser
// (data-offset → data-start-time) so every format shows a meaningful reading.
const row = 'display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--spacing-5)';
const caption = 'font-size:var(--font-size-xs);color:var(--color-text-secondary)';
const cell = 'display:inline-flex;flex-direction:column;gap:var(--spacing-1);min-width:120px';
---
<div style="display:grid;gap:var(--spacing-5);color:var(--color-text-primary)" data-test="timers">
  <div style={row}>
    <span style={cell}><Timer data-case="elapsed-mount" /><span style={caption}>elapsed, from mount</span></span>
    <span style={cell}><Timer format="clock" data-case="clock-mount" /><span style={caption}>clock, from mount</span></span>
    <span style={cell}><Timer data-offset="125000" data-case="elapsed-minutes" /><span style={caption}>elapsed, started 2m 05s ago</span></span>
    <span style={cell}><Timer data-offset="3900000" data-case="elapsed-hours" /><span style={caption}>elapsed, 1h 05m ago (per minute)</span></span>
    <span style={cell}><Timer format="clock" data-offset="3723000" data-case="clock-hours" /><span style={caption}>clock, 1:02:03 ago</span></span>
    <span style={cell}><Timer data-offset="-5000" data-case="future" /><span style={caption}>starts in 5s (holds at 0s)</span></span>
  </div>
  <div style={row}>
    <span style={cell}><Timer type="body" size="lg" color="primary" weight="semibold" data-offset="42000" /><span style={caption}>prominent</span></span>
    <span style={cell}><Text type="large">Processing for <Timer type="inherit" color="inherit" data-offset="9000" /></Text><span style={caption}>inherit surrounding text</span></span>
    <span style={cell}><Timer color="accent" format="clock" data-offset="65000" /><span style={caption}>accent clock</span></span>
  </div>
  <div style={row}>
    <span style={cell}><Timer locale="ar-EG" data-offset="185000" data-case="locale-ar" /><span style={caption}>locale ar-EG (native digits)</span></span>
    <span style={cell}><Timer locale="hi-IN-u-nu-deva" format="clock" data-offset="3723000" data-case="locale-deva" /><span style={caption}>hi-IN, Devanagari digits</span></span>
    <span style={cell}><Timer locale="es-ES" format="clock" data-offset="61000" data-case="locale-es" /><span style={caption}>es-ES (Latin digits)</span></span>
  </div>
  <div style={row}>
    <span style={cell}><Timer startTime={Temporal.Instant.from('2026-01-01T00:00:00Z')} data-case="temporal" /><span style={caption}>startTime: a Temporal.Instant (since 2026-01-01)</span></span>
  </div>
</div>
<script>
  import {Temporal} from '../../lib/temporal';

  document.querySelectorAll<HTMLElement>('[data-test="timers"] [data-offset]').forEach((el) => {
    // The offset attribute sits on the <time>; its <ax-timer> root counts from the start.
    const timer = el.closest('ax-timer');
    timer?.setAttribute('data-start-time', String(Temporal.Now.instant().epochMilliseconds - Number(el.dataset.offset)));
  });
</script>
