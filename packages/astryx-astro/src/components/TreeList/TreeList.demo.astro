---
import TreeList, {type TreeListDensity, type TreeListItemData} from './TreeList.astro';
import Badge from '../Badge/Badge.astro';

const folder = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4l2 2.5h9A1.5 1.5 0 0 1 21 9v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/></svg>';
const file = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/></svg>';

const files: TreeListItemData[] = [
  {id: 'src', label: 'src', startContent: folder, isExpanded: true, children: [
    {id: 'components', label: 'components', startContent: folder, isExpanded: true, children: [
      {id: 'button', label: 'Button.astro', startContent: file, interactiveRole: 'button'},
      {id: 'card', label: 'Card.astro', startContent: file, interactiveRole: 'button', isSelected: true},
      {id: 'tree', label: 'TreeList.astro', startContent: file, interactiveRole: 'button', description: 'Recursive rows'},
    ]},
    {id: 'lib', label: 'lib', startContent: folder, children: [
      {id: 'cascade', label: 'cascade.ts', startContent: file, interactiveRole: 'button'},
      {id: 'uid', label: 'uid.ts', startContent: file, interactiveRole: 'button'},
    ]},
    {id: 'index', label: 'index.ts', startContent: file, interactiveRole: 'button'},
  ]},
  {id: 'docs', label: 'docs', startContent: folder, children: [
    {id: 'guide', label: 'guide.md', startContent: file, href: '#tree-target'},
    {id: 'api', label: 'api.md', startContent: file, href: '#tree-target', isDisabled: true},
  ]},
  {id: 'archive', label: 'archive (disabled)', startContent: folder, isDisabled: true, children: [{id: 'old', label: 'old.txt', startContent: file}]},
  {id: 'pkg', label: 'package.json', startContent: file, interactiveRole: 'button'},
  {id: 'readme', label: 'README.md', startContent: file, interactiveRole: 'button'},
];

const links: TreeListItemData[] = [
  {id: 'l-overview', label: 'Overview', href: '#tree-target'},
  {id: 'l-components', label: 'Components', isExpanded: true, children: [
    {id: 'l-button', label: 'Button', href: '#tree-target', description: 'Actions'},
    {id: 'l-tree', label: 'Tree list', href: '#tree-target', target: '_blank', description: 'Opens in a new tab'},
  ]},
  {id: 'l-changelog', label: 'Changelog', href: '#tree-target'},
];

const flat: TreeListItemData[] = [
  {id: 'f-a', label: 'Alpha'}, {id: 'f-b', label: 'Bravo', isSelected: true}, {id: 'f-c', label: 'Charlie'},
];

const nested: TreeListItemData[] = [
  {id: 'n-1', label: 'Level 1', isExpanded: true, children: [
    {id: 'n-2', label: 'Level 2', isExpanded: true, children: [
      {id: 'n-3', label: 'Level 3', isExpanded: true, children: [{id: 'n-4', label: 'Level 4'}]},
      {id: 'n-2b', label: 'Sibling'},
    ]},
  ]},
  {id: 'n-last', label: 'Last root'},
];

const densities: TreeListDensity[] = ['compact', 'balanced', 'spacious'];
const cap = 'margin:0 0 var(--spacing-2);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);color:var(--color-text-secondary)';
const grid = 'display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:var(--spacing-5);align-items:start';
---
<div style="display:grid;gap:var(--spacing-6);color:var(--color-text-primary)">
  <section>
    <h3 style={cap}>File explorer (selection, disabled rows, slots, animated expand)</h3>
    <div style={grid}>
      <TreeList items={files} header="Project files" animatedLayout id="tree-files" data-test="files">
        <Badge slot="end:components" label={3} variant="blue" />
        <span slot="end:lib" style="font-size:var(--text-supporting-size);color:var(--color-text-secondary)">2 files</span>
      </TreeList>
      <div>
        <TreeList items={links} aria-label="Documentation" id="tree-links" data-test="links" />
        <p id="tree-target" style="margin:var(--spacing-3) 0 0;font-size:var(--text-supporting-size);color:var(--color-text-secondary)">Selected: <output data-test="selected">card</output></p>
      </div>
    </div>
  </section>

  <section>
    <h3 style={cap}>Density, guides, flat tree</h3>
    <div style={grid}>
      {densities.map((density) => <TreeList items={nested} density={density} aria-label={`${density} tree`} />)}
      <TreeList items={nested} variant="noGuides" aria-label="No guides" />
      <TreeList items={flat} aria-label="Flat tree" />
    </div>
  </section>

  <section dir="rtl">
    <h3 style={cap}>RTL</h3>
    <TreeList items={nested} aria-label="RTL tree" id="tree-rtl" data-test="rtl" style="max-width:320px" />
  </section>
</div>
<script>
  const out = document.querySelector('[data-test="selected"]');
  const files = document.getElementById('tree-files');
  files?.addEventListener('astryx-select', (event) => {
    const {id} = (event as CustomEvent<{id: string}>).detail;
    (files as HTMLElement & {selectedId: string | null}).selectedId = id;
    if (out) out.textContent = id;
  });
</script>
