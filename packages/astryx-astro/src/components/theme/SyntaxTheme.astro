---
/**
 * SyntaxTheme — swaps the syntax-highlighting tokens (`--color-syntax-*`) of every code
 * component in its subtree. Port of @astryxdesign/core theme/syntax/SyntaxTheme.tsx.
 *
 * Renders Astryx's wrapper `<div data-astryx-syntax-theme="<name>">`:
 *  - a preset name (`'dracula'`, `'github-light'` … the 12 Astryx presets) needs no inline
 *    style: `src/styles/syntax.css` (generated by scripts/build-syntax.mjs from Astryx's
 *    tokens.ts / presets.ts) styles `[data-astryx-syntax-theme="<preset>"]`;
 *  - a `defineSyntaxTheme()` object writes its tokens inline, as Astryx does;
 *  - any other string only names the attribute, for a theme you style in your own CSS.
 * The same stylesheet holds the `:root` defaults (derived from the palette), which the
 * active theme's `syntax` and this wrapper override. CodeBlock reads the tokens.
 *
 * Not ported: `useSyntaxTheme()` (client token resolution for canvas painters); resolve a
 * definition's values server-side with `resolveSyntaxTokenForMode()` from ./syntaxTheme.ts.
 *
 * @example
 * <SyntaxTheme theme="dracula"><CodeBlock code="const a = 1;" language="ts" /></SyntaxTheme>
 */
import {mergeStyles} from '../../lib/style';
import {syntaxThemeStyle, type SyntaxPresetName, type SyntaxThemeDefinition} from './syntaxTheme';
import '../../styles/syntax.css';

export type {SyntaxPresetName, SyntaxThemeDefinition} from './syntaxTheme';

export interface Props {
  /** A preset name, a `defineSyntaxTheme()` result, or the name of a theme styled in your CSS. */
  theme: SyntaxPresetName | SyntaxThemeDefinition | (string & {});
}

const {theme} = Astro.props;
const definition = typeof theme === 'string' ? null : theme;
const name = definition ? definition.name : (theme as string);
---
<div data-astryx-syntax-theme={name} style={definition ? mergeStyles(syntaxThemeStyle(definition)) : undefined}><slot /></div>
